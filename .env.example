# Copie para .env (que NUNCA vai para o Git) e preencha só na sua máquina.
# Usado apenas pelo "npm run deploy" (envio por FTP). O site em si não lê este arquivo.
# A senha do FTP você digita aqui, no seu computador. Não envie por chat nem por e-mail.

FTP_HOST=ftp.olorin.com.br
FTP_USUARIO=
FTP_SENHA=
# Pasta do site no servidor da Locaweb
FTP_PASTA=/public_html
# true = FTPS (recomendado, se a Locaweb aceitar no seu plano)
FTP_SEGURO=true
