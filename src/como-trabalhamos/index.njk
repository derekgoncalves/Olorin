---
layout: layouts/base.njk
modo: hub
slug: como-trabalhamos
pagina_dados: como-trabalhamos
og_imagem: /assets/img/og/home.jpg
migalhas:
  - { nome: Home, url: / }
  - { nome: Como trabalhamos, url: /como-trabalhamos/ }
eleventyComputed:
  titulo: "{{ conteudo.paginas['como-trabalhamos'].seo.titulo }}"
  descricao: "{{ conteudo.paginas['como-trabalhamos'].seo.descricao }}"
---
{#- Página Como trabalhamos — textos em src/content/paginas/como-trabalhamos.yml; etapas do método em src/content/home.yml. -#}
{%- import "components/ui.njk" as ui with context -%}
{%- set h = conteudo.paginas['como-trabalhamos'] -%}
<section class="o-pagina-topo o-servico-topo o-ctx-preto" data-secao="metodo-hero">
	<div class="o-fundo o-fundo--colunas" aria-hidden="true" data-o-fundo><div class="o-fundo__luz"></div><b></b><b></b><b></b><b></b><b></b></div>
	<div class="o-wrap o-pagina-topo__grade">
		<div class="o-pagina-topo__texto">
			{{ ui.migalhas(migalhas) }}
			<p class="o-etiqueta">{{ h.etiqueta }}</p>
			<h1 class="o-pagina-topo__titulo">{{ h.titulo }}</h1>
			<p class="o-pagina-topo__sub">{{ h.sub }}</p>
			<div class="o-hero__acoes">
				<a class="o-btn o-btn--verde o-btn--grande" id="cta-diagnostico-metodo" href="#orcamento">{{ conteudo.home.hero.botao if site.config.OFERTA_DIAGNOSTICO else conteudo.home.hero.botao_sem_diagnostico }}</a>
				<a class="o-link-wa" href="{{ waLink('metodo-hero') }}" target="_blank" rel="noopener"><span class="o-icone o-icone--whatsapp" aria-hidden="true"></span>{{ conteudo.home.hero.link_whatsapp }}</a>
			</div>
		</div>
		<div class="o-janela o-cena o-cena--hub" aria-hidden="true" data-o-cena>
			<div class="o-janela__barra"><span class="o-janela__titulo">{{ h.janela }}</span><span class="o-janela__ctrl"></span></div>
			<div class="o-cena__palco">
				<ol class="o-cena-hub o-cena-hub--metodo">
				{%- set iconesMetodo = ["dados", "seta", "estrela", "relogio"] %}
				{%- for e in conteudo.home.metodo.etapas %}
					<li class="o-cena-hub__app"><span class="o-icone o-icone--{{ iconesMetodo[loop.index0] or 'pixel' }}"></span><span class="o-cena-hub__nome">0{{ loop.index }} {{ e.nome }}</span></li>
				{%- endfor %}
				</ol>
			</div>
			<ul class="o-cena__linhas">
			{%- for linha in h.janela_linhas %}<li>{{ linha }}</li>{% endfor %}
			</ul>
		</div>
	</div>
</section>
{% include "secoes/metodo.njk" %}
<section class="o-sec o-ctx-branco o-metodo-raio-x" id="raio-x" data-secao="raio-x" aria-labelledby="raio-x-titulo">
	<div class="o-wrap">
		<div class="o-vitrine__cabeca">
			<div>
				<p class="o-etiqueta">{{ h.raio_x.etiqueta }}</p>
				<h2 class="o-titulo o-titulo--g" id="raio-x-titulo">{{ h.raio_x.titulo }}</h2>
			</div>
			<p class="o-apoio">{{ h.raio_x.texto }}</p>
		</div>
		<ol class="o-jeito o-jeito--passos">
		{%- for p in h.raio_x.passos %}
			<li class="o-jeito__item o-janela">
				<div class="o-janela__barra" aria-hidden="true"><span class="o-janela__titulo">passo_0{{ loop.index }}.exe</span><span class="o-janela__ctrl"></span></div>
				<div class="o-janela__corpo o-jeito__corpo">
					<span class="o-jeito__icone o-jeito__icone--num" aria-hidden="true">0{{ loop.index }}</span>
					<h3 class="o-jeito__titulo">{{ p.titulo }}</h3>
					<p class="o-jeito__texto">{{ p.texto }}</p>
				</div>
			</li>
		{%- endfor %}
		</ol>
		<p class="o-metodo-raio-x__acao"><a class="o-btn o-btn--violeta o-btn--grande" href="#orcamento" data-cta="metodo-raio-x">{{ conteudo.home.hero.botao }}</a></p>
	</div>
</section>
{% include "secoes/relatorio.njk" %}
{%- set origemWaForm = "metodo-form" -%}
{%- set origemWaFinal = "metodo-final" -%}
{% include "secoes/orcamento.njk" %}
