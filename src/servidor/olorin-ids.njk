{#- Gera public_html/olorin-ids.js: IDs de medição e link de agendamento que o dono edita pelo
    WebFTP com o site no ar, sem novo build. Os valores iniciais vêm de src/_data/site/config.json
    (hoje vazios). O main.js lê window.OLORIN_IDS e usa só os campos preenchidos (modulos/ids.js).
    Guia completo: docs/TRACKING.md, seção 2. -#}
{%- set cfg = site.config -%}
/*
 * OLORIN DIGITAL: IDS DE MEDIÇÃO E LINK DE AGENDAMENTO
 * ====================================================
 * Pode ser editado com o site no ar (WebFTP da Locaweb, pasta public_html).
 * Troque só o que está ENTRE AS ASPAS. Campo vazio ("") = desligado.
 * Não apague vírgulas, aspas nem chaves. Depois de salvar, abra o site e aperte Ctrl+F5.
 *
 * GTM_ID .................. Google Tag Manager. Exemplo: "GTM-XXXXXXX"
 * GA4_ID .................. Google Analytics 4. Exemplo: "G-XXXXXXXXXX"
 * META_PIXEL_ID ........... Pixel da Meta, só números. Exemplo: "123456789012345"
 * GADS_CONVERSION_ID ...... Google Ads, ID de conversão. Exemplo: "AW-123456789"
 * GADS_CONVERSION_LABEL ... Google Ads, rótulo da conversão. Exemplo: "AbCdEfGhIjKlMnOp"
 * SCHEDULING_URL .......... Link de agenda da página /obrigado/, com https://
 *                           Exemplo: "https://calendly.com/olorin/30min"
 *
 * Com GTM_ID preenchido, o site carrega só o GTM: GA4 e Pixel ficam configurados dentro dele.
 * Sem GTM, o site liga sozinho o GA4, o Pixel e a conversão do Google Ads preenchidos aqui.
 * O aviso de cookies aparece sozinho quando há algum ID preenchido.
 * Ao publicar um site novo (zip), guarde uma cópia deste arquivo e envie a sua de volta depois.
 */
window.OLORIN_IDS = {
	GTM_ID: {{ (cfg.GTM_ID or "") | dump | safe }},
	GA4_ID: {{ (cfg.GA4_ID or "") | dump | safe }},
	META_PIXEL_ID: {{ (cfg.META_PIXEL_ID or "") | dump | safe }},
	GADS_CONVERSION_ID: {{ (cfg.GADS_CONVERSION_ID or "") | dump | safe }},
	GADS_CONVERSION_LABEL: {{ (cfg.GADS_CONVERSION_LABEL or "") | dump | safe }},
	SCHEDULING_URL: {{ (cfg.SCHEDULING_URL or "") | dump | safe }}
};
