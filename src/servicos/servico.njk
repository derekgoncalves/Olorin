---
layout: layouts/base.njk
modo: servico
pagination:
  data: conteudo.servicos
  size: 1
  alias: servico
  addAllPagesToCollections: true
permalink: "/servicos/{{ servico.slug }}/"
eleventyComputed:
  titulo: "{{ servico.seo.title }}"
  descricao: "{{ servico.seo.description }}"
  slug: "servico-{{ servico.slug }}"
  og_imagem: "/assets/img/og/servico-{{ servico.slug }}.jpg"
---
{#- Página de serviço (modo completo) — conteúdo em src/content/servicos/<slug>.yml. Ordem da seção 9.2 do PROMPT. -#}
{%- import "components/ui.njk" as ui with context -%}
{%- from "components/formulario.njk" import formulario with context -%}
{%- set s = servico -%}
{%- set trilha = [{ nome: "Home", url: "/" }, { nome: "Serviços", url: "/servicos/" }, { nome: s.nome, url: "/servicos/" + s.slug + "/" }] -%}
{%- set casesServico = conteudo.cases.itens | filtrarPor("aprovado", true) | filtrarPor("servicos", s.slug) -%}

{#- 1-2 · Trilha + banner do serviço -#}
<section class="o-pagina-topo o-ctx-preto" data-secao="servico-hero">
	<div class="o-wrap o-pagina-topo__grade">
		<div class="o-pagina-topo__texto">
			{{ ui.migalhas(trilha) }}
			<p class="o-etiqueta">{{ s.hero.eyebrow }}</p>
			<h1 class="o-pagina-topo__titulo">{{ s.hero.h1 }}</h1>
			<p class="o-pagina-topo__sub">{{ s.hero.sub }}</p>
			<div class="o-hero__acoes">
				<a class="o-btn o-btn--verde o-btn--grande" id="cta-diagnostico-servico" href="#diagnostico">{{ conteudo.home.hero.botao if site.config.OFERTA_DIAGNOSTICO else conteudo.home.hero.botao_sem_diagnostico }}</a>
				<a class="o-link-wa" href="{{ waLink('servico-' + s.slug + '-hero', { tipo: 'servico', x: s.nome }) }}" target="_blank" rel="noopener" data-servico="{{ s.slug }}"><span class="o-icone o-icone--whatsapp" aria-hidden="true"></span>{{ conteudo.home.hero.link_whatsapp }}</a>
			</div>
			<p class="o-nota"><span class="o-icone o-icone--relogio" aria-hidden="true"></span>{{ conteudo.home.hero.microtexto }}</p>
		</div>
		<div class="o-janela o-servico-janela" aria-hidden="true">
			<div class="o-janela__barra"><span class="o-janela__titulo">{{ s.janela }}</span><span class="o-janela__ctrl"></span></div>
			<div class="o-servico-janela__corpo">
				<span class="o-icone o-icone--{{ s.icone }} o-servico-janela__icone"></span>
				<ul class="o-servico-janela__linhas">
				{%- for linha in s.hero.janela_linhas %}<li>{{ linha }}</li>{% endfor %}
				</ul>
			</div>
		</div>
	</div>
</section>

{#- Índice de seções fixo -#}
<nav class="o-indice" aria-label="Nesta página" data-o-indice>
	<div class="o-wrap">
		<ul class="o-indice__lista">
			<li><a href="#resposta">Resumo</a></li>
			<li><a href="#para-quem">Para quem é</a></li>
			<li><a href="#entregas">O que entregamos</a></li>
			<li><a href="#como-funciona">Como funciona</a></li>
			<li><a href="#quem-faz">Quem faz</a></li>
			<li><a href="#preco">Quanto custa</a></li>
			<li><a href="#perguntas">Dúvidas</a></li>
			<li><a href="#orcamento">Pedir Raio-X</a></li>
		</ul>
	</div>
</nav>

{#- Etapa 1 do formulário logo abaixo do banner -#}
<section class="o-sec o-sec--compacta o-form-topo o-ctx-preto" id="diagnostico" data-secao="formulario-topo" aria-labelledby="diagnostico-titulo">
	<div class="o-wrap o-form-topo__grade">
		<div class="o-form-topo__texto">
			<h2 class="o-titulo o-titulo--m" id="diagnostico-titulo">{{ conteudo.home.formulario_topo.titulo }}</h2>
			<p class="o-apoio">{{ conteudo.home.formulario_topo.texto }}</p>
			<ul class="o-lista-pixel">{% for item in conteudo.home.formulario_topo.itens %}<li>{{ item }}</li>{% endfor %}</ul>
		</div>
		{{ formulario({ id: "form-topo", posicao: "topo", modo: "servico", servico: s.slug, nomeServico: s.nome, origemWa: "servico-" + s.slug + "-form-topo" }) }}
	</div>
</section>

{#- 3 · Resposta curta -#}
<section class="o-sec o-sec--compacta o-ctx-branco" id="resposta" data-secao="resposta-curta" aria-labelledby="resposta-titulo">
	<div class="o-wrap o-resposta">
		<p class="o-etiqueta" id="resposta-titulo">Resumo em 30 segundos</p>
		<p class="o-resposta__texto">{{ s.resposta_curta | emLinha | confirmar | safe }}</p>
		<p class="o-atualizado">Atualizado em <time datetime="{{ s.atualizado }}">{{ s.atualizado | dataBR }}</time></p>
	</div>
</section>

{#- 4 · Dores -#}
{%- if s.dores and s.dores.itens.length %}
<section class="o-sec o-ctx-branco o-servico-dores" data-secao="dores" aria-labelledby="dores-titulo">
	<div class="o-wrap">
		<h2 class="o-titulo o-titulo--g" id="dores-titulo">{{ s.dores.titulo }}</h2>
		<ul class="o-dores">
		{%- for d in s.dores.itens %}
			<li class="o-dor"><span class="o-dor__num" aria-hidden="true">0{{ loop.index }}</span><p>{{ d | emLinha | safe }}</p></li>
		{%- endfor %}
		</ul>
	</div>
</section>
{%- endif %}

{#- 5 · Para quem é / não é -#}
<section class="o-sec o-ctx-preto" id="para-quem" data-secao="para-quem" aria-labelledby="para-quem-titulo">
	<div class="o-wrap">
		<h2 class="o-titulo o-titulo--g" id="para-quem-titulo">Para quem é (e para quem não é)</h2>
		<div class="o-para-quem">
			<div class="o-para-quem__col o-para-quem__col--sim">
				<h3 class="o-para-quem__titulo"><span class="o-icone o-icone--check" aria-hidden="true"></span>É para…</h3>
				<ul class="o-lista-pixel">{% for i in s.para_quem.e %}<li>{{ i | emLinha | confirmar | safe }}</li>{% endfor %}</ul>
			</div>
			<div class="o-para-quem__col o-para-quem__col--nao">
				<h3 class="o-para-quem__titulo"><span class="o-icone o-icone--mais o-icone--x" aria-hidden="true"></span>Não é para…</h3>
				<ul class="o-lista-pixel">{% for i in s.para_quem.nao_e %}<li>{{ i | emLinha | confirmar | safe }}</li>{% endfor %}</ul>
			</div>
		</div>
	</div>
</section>

{#- 6 · Entregas -#}
<section class="o-sec o-ctx-branco" id="entregas" data-secao="entregas" aria-labelledby="entregas-titulo">
	<div class="o-wrap">
		<h2 class="o-titulo o-titulo--g" id="entregas-titulo">{{ s.entregas.titulo }}</h2>
		<ul class="o-entregas">
		{%- for e in s.entregas.itens %}
			<li class="o-entrega">
				<span class="o-icone o-icone--{{ e.icone or s.icone }} o-entrega__icone" aria-hidden="true"></span>
				<h3 class="o-entrega__titulo">{{ e.titulo }}</h3>
				<p class="o-entrega__texto">{{ e.texto | emLinha | confirmar | safe }}</p>
				{%- if e.frequencia %}<p class="o-entrega__freq"><span class="o-icone o-icone--relogio" aria-hidden="true"></span>{{ e.frequencia | confirmar | safe }}</p>{% endif %}
			</li>
		{%- endfor %}
		</ul>
	</div>
</section>

{#- 7 · Como funciona (Método Olorin adaptado) -#}
<section class="o-sec o-metodo o-ctx-violeta" id="como-funciona" data-secao="como-funciona" aria-labelledby="como-titulo">
	<div class="o-wrap o-metodo__grade">
		<div class="o-metodo__cabeca">
			<p class="o-etiqueta">Método Olorin</p>
			<h2 class="o-titulo o-titulo--g" id="como-titulo">{{ s.como_funciona.titulo }}</h2>
			<p class="o-metodo__progresso" aria-hidden="true" data-o-metodo-progresso><span class="o-medidor">{% for e in s.como_funciona.etapas %}<i></i>{% endfor %}</span><span data-o-metodo-rotulo></span></p>
		</div>
		<ol class="o-etapas" data-o-etapas>
		{%- for e in s.como_funciona.etapas %}
			<li class="o-etapa"><span class="o-etapa__num" aria-hidden="true">0{{ loop.index }}</span><h3 class="o-etapa__nome">{{ e.nome }}</h3><p class="o-etapa__texto">{{ e.texto | emLinha | confirmar | safe }}</p></li>
		{%- endfor %}
		</ol>
	</div>
	{%- if s.como_funciona.prazos and s.como_funciona.prazos.length %}
	<div class="o-wrap o-prazos">
		<p class="o-etiqueta">Primeiros 90 dias</p>
		<ul class="o-lista-pixel">{% for p in s.como_funciona.prazos %}<li>{{ p | emLinha | confirmar | safe }}</li>{% endfor %}</ul>
	</div>
	{%- endif %}
</section>

{#- 8 · O que precisamos de você -#}
{%- if s.precisamos and s.precisamos.itens.length %}
<section class="o-sec o-sec--compacta o-ctx-branco" data-secao="precisamos" aria-labelledby="precisamos-titulo">
	<div class="o-wrap o-duas-colunas">
		<h2 class="o-titulo o-titulo--m" id="precisamos-titulo">{{ s.precisamos.titulo }}</h2>
		<ul class="o-lista-pixel">{% for i in s.precisamos.itens %}<li>{{ i | emLinha | confirmar | safe }}</li>{% endfor %}</ul>
	</div>
</section>
{%- endif %}

{#- 9 · Quem faz -#}
<section class="o-sec o-sec--compacta o-ctx-preto" id="quem-faz" data-secao="quem-faz" aria-labelledby="quem-faz-titulo">
	<div class="o-wrap">
		<p class="o-etiqueta">Quem faz</p>
		<h2 class="o-titulo o-titulo--m" id="quem-faz-titulo">Quem cuida disso na Olorin</h2>
		<div class="o-quem-faz">
		{%- for slugPessoa in s.quem_faz %}
			{%- set pessoa = conteudo.pessoaPorSlug[slugPessoa] %}
			{%- if pessoa %}{{ ui.cardPessoa(pessoa, "h3", true) }}{% endif %}
		{%- endfor %}
		</div>
		{%- if s.quem_faz_nota %}<p class="o-apoio">{{ s.quem_faz_nota | confirmar | safe }}</p>{% endif %}
		<a class="o-link-seta" href="/sobre/">Conheça o time da Olorin <span class="o-icone o-icone--seta" aria-hidden="true"></span></a>
	</div>
</section>

{#- 10 · Resultados e cases do serviço (só com case aprovado) -#}
{%- if casesServico.length %}
<section class="o-sec o-resultados o-ctx-verde" data-secao="cases-servico" aria-labelledby="cases-servico-titulo">
	<div class="o-wrap">
		<h2 class="o-titulo o-titulo--g" id="cases-servico-titulo">Resultados com {{ s.nome | lower }}</h2>
		<div class="o-cases">
		{%- for c in casesServico %}
			<article class="o-case o-janela">
				<div class="o-janela__barra" aria-hidden="true"><span class="o-janela__titulo">{{ c.janela }}</span><span class="o-janela__ctrl"></span></div>
				<div class="o-janela__corpo"><h3 class="o-case__segmento">{{ c.segmento }}</h3><p class="o-case__servicos">{{ c.servicos_texto }}</p><p class="o-case__resultado">{{ c.resultado }}</p><p class="o-case__detalhe">{{ c.detalhe }}</p><a class="o-case__link" href="/cases/{{ c.slug }}/">Ver o case completo</a></div>
			</article>
		{%- endfor %}
		</div>
	</div>
</section>
{%- endif %}

{#- 11 · Quanto custa -#}
<section class="o-sec o-ctx-branco" id="preco" data-secao="preco" aria-labelledby="preco-titulo">
	<div class="o-wrap">
		<h2 class="o-titulo o-titulo--g" id="preco-titulo">{{ s.preco.titulo }}</h2>
		<div class="o-preco">
			<div class="o-preco__caixa o-janela">
				<div class="o-janela__barra" aria-hidden="true"><span class="o-janela__titulo">preco.txt</span><span class="o-janela__ctrl"></span></div>
				<div class="o-janela__corpo">
					{%- if s.preco.formato %}<p class="o-preco__formato">{{ s.preco.formato | confirmar | safe }}</p>{% endif %}
					{%- if s.preco.valor %}<p class="o-preco__valor">{{ s.preco.valor | confirmar | safe }}</p>{% elif s.preco.sem_valor %}<p class="o-preco__detalhe o-preco__sem-valor">{{ s.preco.sem_valor | emLinha | safe }}</p>{% endif %}
					{%- if s.preco.faixa %}<p class="o-preco__detalhe">{{ s.preco.faixa | emLinha | confirmar | safe }}</p>{% endif %}
					{%- if s.preco.detalhe %}<p class="o-preco__detalhe">{{ s.preco.detalhe | emLinha | confirmar | safe }}</p>{% endif %}
					{%- if s.preco.total and site.config.SHOW_TOTAL_COST %}<p class="o-preco__total">{{ s.preco.total | confirmar | safe }}</p>{% endif %}
					{%- if s.preco.contrato %}<p class="o-preco__detalhe">{{ s.preco.contrato | confirmar | safe }}</p>{% endif %}
					<a class="o-btn o-btn--verde" href="#orcamento" data-cta="servico-{{ s.slug }}-preco">{{ "Quero meu Raio-X gratuito" if site.config.OFERTA_DIAGNOSTICO else "Pedir orçamento" }}</a>
				</div>
			</div>
			<div class="o-preco__listas">
				{%- if s.preco.inclui and s.preco.inclui.length %}
				<h3 class="o-preco__subtitulo">O que está incluso</h3>
				<ul class="o-lista-pixel">{% for i in s.preco.inclui %}<li>{{ i | emLinha | confirmar | safe }}</li>{% endfor %}</ul>
				{%- endif %}
				{%- if s.preco.nao_inclui and s.preco.nao_inclui.length %}
				<h3 class="o-preco__subtitulo">O que não está incluso</h3>
				<ul class="o-lista-pixel o-lista-pixel--nao">{% for i in s.preco.nao_inclui %}<li>{{ i | emLinha | confirmar | safe }}</li>{% endfor %}</ul>
				{%- endif %}
				<p class="o-preco__planos"><a class="o-link-seta" href="/#planos">Ver todos os planos e a calculadora <span class="o-icone o-icone--seta" aria-hidden="true"></span></a></p>
			</div>
		</div>
	</div>
</section>

{#- 12 · Combina com -#}
{%- if s.combina_com and s.combina_com.length %}
<section class="o-sec o-sec--compacta o-ctx-preto" data-secao="combina-com" aria-labelledby="combina-titulo">
	<div class="o-wrap">
		<h2 class="o-titulo o-titulo--m" id="combina-titulo">Combina com</h2>
		<ul class="o-combina">
		{%- for c in s.combina_com %}
			{%- set outro = conteudo.servicoPorSlug[c.slug] %}
			{%- if outro %}
			<li class="o-combina__item">
				<span class="o-icone o-icone--{{ outro.icone }}" aria-hidden="true"></span>
				<h3 class="o-combina__titulo"><a href="/servicos/{{ outro.slug }}/">{{ outro.nome }}</a></h3>
				<p>{{ c.porque | emLinha | confirmar | safe }}</p>
			</li>
			{%- endif %}
		{%- endfor %}
		</ul>
	</div>
</section>
{%- endif %}

{#- 13 · FAQ específico -#}
<section class="o-sec o-faq o-ctx-branco" id="perguntas" data-secao="faq-servico" aria-labelledby="perguntas-titulo">
	<div class="o-wrap o-faq__grade">
		<div class="o-faq__cabeca">
			<p class="o-etiqueta">Dúvidas sobre {{ s.nome | lower }}</p>
			<h2 class="o-titulo o-titulo--m" id="perguntas-titulo">Perguntas frequentes</h2>
			<a class="o-btn o-btn--contorno" href="{{ waLink('servico-' + s.slug + '-faq', { tipo: 'servico', x: s.nome }) }}" target="_blank" rel="noopener" data-servico="{{ s.slug }}"><span class="o-icone o-icone--whatsapp" aria-hidden="true"></span>Perguntar no WhatsApp</a>
		</div>
		{{ ui.faqLista(s.faq) }}
	</div>
</section>

{#- 14 · CTA final + formulário completo (serviço já marcado) -#}
{%- set servicoForm = s.slug -%}
{%- set nomeServicoForm = s.nome -%}
{%- set origemWaForm = "servico-" + s.slug + "-form-fim" -%}
{%- set origemWaFinal = "servico-" + s.slug + "-final" -%}
{% include "secoes/orcamento.njk" %}
