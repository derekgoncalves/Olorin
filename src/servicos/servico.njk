---
layout: layouts/base.njk
modo: servico
pagination:
  data: conteudo.servicos
  size: 1
  alias: servico
  addAllPagesToCollections: true
permalink: "/servicos/{{ servico.slug }}/"
eleventyComputed:
  titulo: "{{ servico.seo.title }}"
  descricao: "{{ servico.seo.description }}"
  slug: "servico-{{ servico.slug }}"
  og_imagem: "/assets/img/og/servico-{{ servico.slug }}.jpg"
---
{#- Página de serviço — conteúdo em src/content/servicos/<slug>.yml (a mesma fonte da landing /promo/<slug>/).
    Ordem (17/10/2026): banner com a cena do serviço e o botão do Raio-X e, no pé dele, a barra de logos de
    clientes (18/10/2026), índice da página, o que é,
    "Este é o seu caso?", entregas, ferramentas e redes (tráfego e dados), trabalhos, combina com, Quem somos
    e o formulário do Raio-X. Sem preço, método e dúvidas (dono). -#}
{%- import "components/ui.njk" as ui with context -%}
{%- set s = servico -%}
{%- set trilha = [{ nome: "Home", url: "/" }, { nome: "Serviços", url: "/servicos/" }, { nome: s.nome, url: "/servicos/" + s.slug + "/" }] -%}
{%- set casesServico = (conteudo.casesTodos or []) | filtrarPor("servicos", s.slug) -%}
{%- set trabalhos = (conteudo.portfolioPublicado or []) | filtrarPor("servicos", s.slug) -%}
{%- set cena = s.cena or s.icone -%}
{%- set fe = s.ferramentas -%}

{#- 1 · Banner com a cena viva do serviço -#}
<section class="o-pagina-topo o-servico-topo o-ctx-preto" data-secao="servico-hero">
	<div class="o-fundo o-fundo--colunas" aria-hidden="true" data-o-fundo><div class="o-fundo__luz"></div><b></b><b></b><b></b><b></b><b></b></div>
	<div class="o-wrap o-pagina-topo__grade">
		<div class="o-pagina-topo__texto">
			{{ ui.migalhas(trilha) }}
			<p class="o-etiqueta">{{ s.hero.eyebrow }}</p>
			<h1 class="o-pagina-topo__titulo">{{ s.hero.h1 }}</h1>
			<p class="o-pagina-topo__sub">{{ s.hero.sub }}</p>
			<div class="o-hero__acoes">{{ ui.botaoRaioX("cta-raio-x-servico-" + s.slug + "-banner", classe="o-btn--grande") }}</div>
			{%- if s.hero.selos %}
			<ul class="o-prova">{% for item in s.hero.selos %}<li>{{ item }}</li>{% endfor %}</ul>
			{%- endif %}
		</div>
		<div class="o-janela o-cena o-cena--{{ cena }}" aria-hidden="true" data-o-cena>
			<div class="o-janela__barra"><span class="o-janela__titulo">{{ s.janela }}</span><span class="o-janela__ctrl"></span></div>
			<div class="o-cena__palco">
			{%- if cena == "trafego" %}
				<div class="o-cena-trafego"><p class="o-cena__rotulo">retorno</p><div class="o-cena-trafego__barras"><i></i><i></i><i></i><i></i><i></i><i></i></div><span class="o-cena__seta"></span></div>
			{%- elif cena == "redes" %}
				{#- Celular com stories, feed rolando, curtida e avisos saindo da tela. -#}
				<div class="o-cena-redes">
					<div class="o-cel">
						<div class="o-cel__topo"><svg class="o-cel__marca" viewBox="0 0 134 126" focusable="false"><use href="#s-o"></use></svg><i></i><b></b></div>
						<ul class="o-cel__stories"><li></li><li></li><li></li><li></li><li></li></ul>
						<div class="o-cel__feed">
							<div class="o-cel__trilho">
							{%- for n in [1, 2, 3, 1] %}
								<div class="o-cel__post o-cel__post--{{ n }}"><p class="o-cel__autor"><i></i><b></b></p><div class="o-cel__foto"><svg viewBox="0 0 134 126" focusable="false"><use href="#s-o"></use></svg></div><p class="o-cel__acoes"><span class="o-cel__curtir"></span><i></i><i></i><b></b></p><p class="o-cel__legenda"><i></i><i></i></p></div>
							{%- endfor %}
							</div>
							<span class="o-cel__estouro"></span>
						</div>
					</div>
					<ul class="o-cena-redes__avisos"><li class="o-cena-redes__aviso--curtida">curtiu</li><li class="o-cena-redes__aviso--seguidor">novo seguidor</li><li class="o-cena-redes__aviso--comentario">comentou</li></ul>
				</div>
			{%- elif cena == "marca" %}
				<div class="o-cena-marca"><svg class="o-cena-marca__o" viewBox="0 0 134 126" focusable="false"><use href="#s-o"></use></svg><span class="o-cena-marca__cores"><i></i><i></i><i></i><i></i></span><span class="o-cena-marca__regua"></span></div>
			{%- elif cena == "impresso" %}
				<div class="o-cena-impresso"><div class="o-cena-impresso__folha"><svg viewBox="0 0 134 126" focusable="false"><use href="#s-o"></use></svg><i></i><i></i><i></i></div><div class="o-cena-impresso__maquina"><i></i></div></div>
			{%- elif cena == "site" %}
				<div class="o-cena-site"><i class="o-cena-site__menu"></i><i class="o-cena-site__hero"></i><i class="o-cena-site__bloco"></i><i class="o-cena-site__bloco"></i><i class="o-cena-site__bloco"></i><i class="o-cena-site__botao"></i></div>
			{%- else %}
				<div class="o-cena-dados"><div class="o-cena-dados__kpis"><i></i><i></i><i></i></div><svg class="o-cena-dados__linha" viewBox="0 0 200 80" preserveAspectRatio="none" focusable="false"><polyline points="0,72 28,64 56,66 84,46 112,50 140,30 168,26 200,8" pathLength="100"></polyline></svg></div>
			{%- endif %}
			</div>
			<ul class="o-cena__linhas">
			{%- for linha in s.hero.janela_linhas %}<li>{{ linha }}</li>{% endfor %}
			</ul>
		</div>
	</div>
	{#- Barra de logos de clientes no pé do banner, no mesmo fundo (secoes/faixa-clientes.njk) -#}
	{%- set faixa_pe = true %}
	{% include "secoes/faixa-clientes.njk" %}
</section>

{#- Índice de seções fixo -#}
<nav class="o-indice" aria-label="Nesta página" data-o-indice>
	<div class="o-wrap">
		<ul class="o-indice__lista">
			<li><a href="#o-que-e">O que é</a></li>
			{%- if s.dores and s.dores.itens.length %}<li><a href="#seu-caso">É o seu caso?</a></li>{% endif %}
			<li><a href="#entregas">O que pode entrar</a></li>
			{%- if fe %}<li><a href="#ferramentas">{{ fe.indice or "Ferramentas" }}</a></li>{% endif %}
			{%- if casesServico.length or trabalhos.length %}<li><a href="#trabalhos">Trabalhos</a></li>{% endif %}
			<li><a href="#equipe">Quem somos</a></li>
			<li><a href="#raio-x">Raio-X grátis</a></li>
		</ul>
	</div>
</nav>

{#- 3 · O que é -#}
<section class="o-sec o-servico-oque o-ctx-branco" id="o-que-e" data-secao="o-que-e" aria-labelledby="oque-titulo">
	<div class="o-wrap o-servico-oque__grade">
		<div class="o-servico-oque__cabeca">
			<p class="o-etiqueta">{{ s.o_que_e.etiqueta or ("O que é " + (s.nome | lower)) }}</p>
			<h2 class="o-titulo o-titulo--g" id="oque-titulo">{{ s.o_que_e.titulo }}</h2>
		</div>
		<div class="o-servico-oque__texto">
			{%- for p in s.o_que_e.texto %}<p>{{ p | emLinha | safe }}</p>{% endfor %}
			{%- if s.o_que_e.destaques %}
			<ul class="o-servico-oque__destaques">
			{%- for d in s.o_que_e.destaques %}<li><span class="o-icone o-icone--pixel" aria-hidden="true"></span>{{ d }}</li>{% endfor %}
			</ul>
			{%- endif %}
		</div>
	</div>
</section>

{#- 4 · Este é o seu caso? (com o botão do Raio-X) -#}
{%- set idCta = "cta-raio-x-servico-" + s.slug + "-caso" -%}
{%- set destinoCta = "#raio-x" -%}
{% include "partials/servico-dores.njk" %}

{#- 5 · O que entra -#}
<section class="o-sec o-ctx-branco o-servico-entregas" id="entregas" data-secao="entregas" aria-labelledby="entregas-titulo">
	<div class="o-wrap">
		<div class="o-vitrine__cabeca">
			<div>
				<p class="o-etiqueta">{{ s.entregas.etiqueta or "Entregas" }}</p>
				<h2 class="o-titulo o-titulo--g" id="entregas-titulo">{{ s.entregas.titulo }}</h2>
			</div>
			{%- if s.entregas.texto %}<p class="o-apoio">{{ s.entregas.texto }}</p>{% endif %}
		</div>
		<ul class="o-entregas">
		{%- for e in s.entregas.itens %}
			<li class="o-entrega">
				<span class="o-icone o-icone--{{ e.icone or s.icone }} o-entrega__icone" aria-hidden="true"></span>
				<h3 class="o-entrega__titulo">{{ e.titulo }}</h3>
				<p class="o-entrega__texto">{{ e.texto | emLinha | safe }}</p>
				<p class="o-entrega__freq">{% if e.frequencia %}<span class="o-icone o-icone--relogio" aria-hidden="true"></span>{{ e.frequencia }}{% endif %}</p>
			</li>
		{%- endfor %}
		</ul>
	</div>
</section>

{#- 6 · Ferramentas e redes que o time opera (tráfego e dados), com a credencial da Natalia (dela, não da agência) -#}
{%- if fe %}
{%- set cr = fe.credencial -%}
{%- set pessoaCr = conteudo.pessoaPorSlug[cr.pessoa] if cr else null -%}
<section class="o-sec o-ferramentas o-ctx-verde" id="ferramentas" data-secao="ferramentas" aria-labelledby="ferramentas-titulo">
	<div class="o-wrap">
		<div class="o-vitrine__cabeca">
			<div>
				<p class="o-etiqueta">{{ fe.etiqueta }}</p>
				<h2 class="o-titulo o-titulo--g" id="ferramentas-titulo">{{ fe.titulo }}</h2>
			</div>
			{%- if fe.texto %}<p class="o-apoio">{{ fe.texto }}</p>{% endif %}
		</div>
		<ul class="o-ferramentas__grade o-ferramentas__grade--{{ fe.itens.length }}">
		{%- for f in fe.itens %}
			<li class="o-ferramenta"><i class="o-ferramenta__logo" style="--logo: url('/assets/img/marcas/{{ f.logo }}.svg')" aria-hidden="true"></i><span class="o-ferramenta__nome">{{ f.nome }}</span></li>
		{%- endfor %}
		</ul>
		{%- if cr %}
		<div class="o-credencial o-ctx-preto">
			{%- if pessoaCr %}
			<span class="o-credencial__foto" aria-hidden="true">{{ imagem(imagens, pessoaCr.foto + "-quadrada", { sizes: "96px" }) | safe }}</span>
			{%- endif %}
			<div class="o-credencial__texto">
				<p class="o-etiqueta">{{ cr.etiqueta }}</p>
				<p class="o-credencial__titulo">{{ cr.titulo }}</p>
				<p class="o-credencial__nome">{% if pessoaCr %}<a href="/quem-somos/{{ pessoaCr.slug }}/">{{ cr.nome }}</a>{% else %}{{ cr.nome }}{% endif %}<span>{{ cr.funcao }}</span></p>
			</div>
			<ul class="o-credencial__selos">
			{%- for l in cr.logos %}
				<li><i class="o-ferramenta__logo" style="--logo: url('/assets/img/marcas/{{ l.logo }}.svg')" aria-hidden="true"></i><span>Parceira {{ l.nome }}</span></li>
			{%- endfor %}
			</ul>
		</div>
		{%- endif %}
	</div>
</section>
{%- endif %}

{#- 7 · Trabalhos do serviço: cases e portfólio -#}
{%- if casesServico.length or trabalhos.length %}
<section class="o-sec o-ctx-preto o-servico-trabalhos" id="trabalhos" data-secao="trabalhos" aria-labelledby="trabalhos-titulo">
	<div class="o-wrap">
		<div class="o-vitrine__cabeca">
			<div>
				<p class="o-etiqueta">Portfólio · {{ s.nome }}</p>
				<h2 class="o-titulo o-titulo--g" id="trabalhos-titulo">{{ s.portfolio.titulo or "Na prática." }}</h2>
			</div>
			{%- if s.portfolio.texto %}<p class="o-apoio">{{ s.portfolio.texto }}</p>{% endif %}
		</div>
		{%- if casesServico.length %}
		<div class="o-cases o-cases--{{ casesServico.length if casesServico.length < 3 else 3 }} o-servico-cases">
		{%- for c in casesServico %}
			<article class="o-case o-janela">
				<div class="o-janela__barra" aria-hidden="true"><span class="o-janela__titulo">{{ c.janela }}</span><span class="o-janela__ctrl"></span></div>
				<div class="o-janela__corpo o-case__corpo">
					<p class="o-case__segmento">{{ c.segmento }}</p>
					<h3 class="o-case__cliente">{{ c.cliente }}</h3>
					{%- if c.resumo %}<p class="o-case__resumo">{{ c.resumo }}</p>{% endif %}
					{%- if c.resultado %}<p class="o-case__resultado" data-o-contador>{{ c.resultado }}</p>{% elif c.destaque %}<p class="o-case__destaque">{{ c.destaque }}</p>{% endif %}
					{%- if c.servicos_texto %}<p class="o-case__servicos"><span class="o-sr">Serviços: </span>{{ c.servicos_texto }}</p>{% endif %}
					{%- if c.pagina %}<a class="o-link-seta o-case__link" href="/cases/{{ c.slug }}/">Ver o case completo <span class="o-icone o-icone--seta" aria-hidden="true"></span></a>{% endif %}
				</div>
			</article>
		{%- endfor %}
		</div>
		{%- endif %}
		{%- if trabalhos.length %}
		<ul class="o-trabalhos o-servico-trabalhos__grade">
		{%- for item in trabalhos %}
			<li class="o-trabalho">
				<figure>
					{{ imagem(imagens, item.imagem, { sizes: "(max-width: 719px) 48vw, (max-width: 1400px) 30vw, 430px", classePicture: "o-trabalho__imagem" }) | safe }}
					<figcaption class="o-trabalho__legenda"><strong>{% if item.link %}<a href="{{ item.link }}" target="_blank" rel="noopener">{{ item.titulo }}</a>{% else %}{{ item.titulo }}{% endif %}</strong><span class="o-trabalho__tipo">{% for tipo in item.rotulo.split(" · ") %}<span>{{ tipo }}{% if not loop.last %} ·{% endif %}</span>{% if not loop.last %} {% endif %}{% endfor %}</span></figcaption>
				</figure>
			</li>
		{%- endfor %}
		</ul>
		{%- endif %}
		<p class="o-vitrine__acoes"><a class="o-btn o-btn--contorno" href="/portfolio/">Ver o portfólio completo</a></p>
	</div>
</section>
{%- endif %}

{#- 8 · Combina com (fundo branco, entre os trabalhos e o Quem somos, que são pretos) -#}
{%- if s.combina_com and s.combina_com.length %}
<section class="o-sec o-sec--compacta o-ctx-branco o-combina-sec" data-secao="combina-com" aria-labelledby="combina-titulo">
	<div class="o-wrap">
		<p class="o-etiqueta">Junto fica melhor</p>
		<h2 class="o-titulo o-titulo--m" id="combina-titulo">Combina com.</h2>
		<ul class="o-combina">
		{%- for c in s.combina_com %}
			{%- set outro = conteudo.servicoPorSlug[c.slug] %}
			{%- if outro %}
			<li class="o-combina__item">
				<span class="o-icone o-icone--{{ outro.icone }}" aria-hidden="true"></span>
				<h3 class="o-combina__titulo"><a href="/servicos/{{ outro.slug }}/">{{ outro.nome }}</a></h3>
				<p>{{ c.porque | emLinha | safe }}</p>
			</li>
			{%- endif %}
		{%- endfor %}
		</ul>
	</div>
</section>
{%- endif %}

{#- 9 · Quem somos (o time todo; substitui o antigo "Quem coordena") -#}
{% include "secoes/equipe.njk" %}

{#- 10 · Formulário do Raio-X (serviço já marcado) -#}
{%- set servicoForm = s.slug -%}
{%- set nomeServicoForm = s.nome -%}
{%- set origemWaForm = "servico-" + s.slug + "-form-fim" -%}
{%- set origemWaFinal = "servico-" + s.slug + "-final" -%}
{% include "secoes/orcamento.njk" %}
