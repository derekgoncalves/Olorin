---
layout: layouts/base.njk
modo: hub
slug: servicos
og_imagem: /assets/img/og/servicos.jpg
migalhas:
  - { nome: Home, url: / }
  - { nome: Serviços, url: /servicos/ }
eleventyComputed:
  titulo: "{{ conteudo.paginas.servicos.seo.titulo }}"
  descricao: "{{ conteudo.paginas.servicos.seo.descricao }}"
---
{#- Hub de serviços — textos em src/content/paginas/servicos.yml. -#}
{%- import "components/ui.njk" as ui with context -%}
{%- set h = conteudo.paginas.servicos -%}
<section class="o-pagina-topo o-ctx-preto" data-secao="hub-hero">
	<div class="o-wrap">
		{{ ui.migalhas(migalhas) }}
		<p class="o-etiqueta">{{ h.etiqueta }}</p>
		<h1 class="o-pagina-topo__titulo">{{ h.titulo }}</h1>
		<p class="o-pagina-topo__sub">{{ h.texto }}</p>
	</div>
</section>

<section class="o-sec o-servicos o-servicos--hub o-ctx-preto" data-secao="servicos" aria-label="Os 6 serviços">
	<div class="o-wrap">
		<div class="o-cards-servico">
		{%- for s in conteudo.servicos %}
			{{ ui.cardServico(s, "h2") }}
		{%- endfor %}
		</div>
	</div>
</section>

<section class="o-sec o-ctx-branco" data-secao="como-escolher" aria-labelledby="escolher-titulo">
	<div class="o-wrap">
		<h2 class="o-titulo o-titulo--g" id="escolher-titulo">{{ h.escolher.titulo }}</h2>
		<ul class="o-escolher">
		{%- for item in h.escolher.situacoes %}
			{%- set alvo = conteudo.servicoPorSlug[item.servico] %}
			<li class="o-escolher__item o-janela">
				<div class="o-janela__barra" aria-hidden="true"><span class="o-janela__titulo">situacao_0{{ loop.index }}.txt</span><span class="o-janela__ctrl"></span></div>
				<div class="o-janela__corpo">
					<p class="o-escolher__situacao">{{ item.situacao }}</p>
					<p class="o-escolher__porque">{{ item.porque }}</p>
					<a class="o-link-seta" href="/servicos/{{ alvo.slug }}/">Comece por {{ alvo.nome }} <span class="o-icone o-icone--seta" aria-hidden="true"></span></a>
				</div>
			</li>
		{%- endfor %}
		</ul>
		<p class="o-escolher__nao-sei">{{ h.escolher.nao_sei }} <a class="o-link-seta" href="/#diagnostico">Pedir diagnóstico <span class="o-icone o-icone--seta" aria-hidden="true"></span></a></p>
	</div>
</section>

<section class="o-sec o-ctx-preto o-combinacoes-sec" data-secao="combinacoes" aria-labelledby="combinacoes-titulo">
	<div class="o-wrap">
		<h2 class="o-titulo o-titulo--g" id="combinacoes-titulo">{{ h.combinacoes.titulo }}</h2>
		<ul class="o-combinacoes">
		{%- for c in h.combinacoes.itens %}
			<li class="o-combinacao">
				<p class="o-combinacao__plano">{{ c.plano }}</p>
				<h3 class="o-combinacao__nome">{{ c.nome }}</h3>
				<p>{{ c.texto }}</p>
			</li>
		{%- endfor %}
		</ul>
		<p class="o-planos__nota">{{ conteudo.planos.nota }}</p>
		<a class="o-btn o-btn--verde" href="/#planos" data-cta="hub-planos">Ver planos e calculadora</a>
	</div>
</section>

{% include "secoes/orcamento.njk" %}
