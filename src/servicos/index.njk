---
layout: layouts/base.njk
modo: hub
slug: servicos
og_imagem: /assets/img/og/servicos.jpg
migalhas:
  - { nome: Home, url: / }
  - { nome: Serviços, url: /servicos/ }
eleventyComputed:
  titulo: "{{ conteudo.paginas.servicos.seo.titulo }}"
  descricao: "{{ conteudo.paginas.servicos.seo.descricao }}"
---
{#- Hub de serviços — textos em src/content/paginas/servicos.yml; cards em src/content/servicos/. -#}
{%- import "components/ui.njk" as ui with context -%}
{%- set h = conteudo.paginas.servicos -%}
<section class="o-pagina-topo o-servico-topo o-servico-topo--hub o-ctx-preto" data-secao="hub-hero">
	<div class="o-fundo o-fundo--colunas" aria-hidden="true" data-o-fundo><div class="o-fundo__luz"></div><b></b><b></b><b></b><b></b><b></b></div>
	<div class="o-wrap o-pagina-topo__grade">
		<div class="o-pagina-topo__texto">
			{{ ui.migalhas(migalhas) }}
			<p class="o-etiqueta">{{ h.etiqueta }}</p>
			<h1 class="o-pagina-topo__titulo">{{ h.titulo }}</h1>
			<p class="o-pagina-topo__sub">{{ h.texto }}</p>
			<form class="o-atalho" action="#orcamento" method="get" data-o-atalho="form-fim" novalidate>
				<label class="o-atalho__rotulo" for="atalho-whatsapp">{{ conteudo.home.hero.atalho.rotulo }}</label>
				<div class="o-atalho__linha">
					<input class="o-atalho__campo" id="atalho-whatsapp" type="tel" inputmode="tel" autocomplete="tel-national" maxlength="20" placeholder="{{ conteudo.home.hero.atalho.placeholder }}" aria-describedby="atalho-ajuda">
					<button class="o-btn o-btn--verde o-atalho__botao" id="cta-diagnostico-hub" type="submit">{{ conteudo.home.hero.atalho.botao }} <span class="o-icone o-icone--seta" aria-hidden="true"></span></button>
				</div>
				<p class="o-atalho__ajuda" id="atalho-ajuda"><span class="o-icone o-icone--relogio" aria-hidden="true"></span>{{ conteudo.home.hero.atalho.ajuda }}</p>
			</form>
			<p class="o-hero__wa"><a class="o-link-wa" href="{{ waLink('servicos-hero') }}" target="_blank" rel="noopener"><span class="o-icone o-icone--whatsapp" aria-hidden="true"></span>{{ conteudo.home.hero.link_whatsapp }}</a></p>
		</div>
		<div class="o-janela o-cena o-cena--hub" aria-hidden="true" data-o-cena>
			<div class="o-janela__barra"><span class="o-janela__titulo">{{ h.janela }}</span><span class="o-janela__ctrl"></span></div>
			<div class="o-cena__palco">
				<ul class="o-cena-hub">
				{%- for s in conteudo.servicos %}
					<li class="o-cena-hub__app"><span class="o-icone o-icone--{{ s.icone }}"></span><span class="o-cena-hub__nome">{{ s.janela }}</span></li>
				{%- endfor %}
				</ul>
			</div>
			<ul class="o-cena__linhas">
				<li>Um time · seis frentes</li>
				<li>Preço aberto · em todas</li>
			</ul>
		</div>
	</div>
</section>

<section class="o-sec o-servicos o-servicos--hub o-ctx-branco" id="servicos" data-secao="servicos" aria-labelledby="servicos-titulo">
	<div class="o-wrap">
		<div class="o-servicos__cabeca">
			<div>
				<p class="o-etiqueta">{{ h.cards.etiqueta }}</p>
				<h2 class="o-titulo o-titulo--g" id="servicos-titulo">{{ h.cards.titulo }}</h2>
			</div>
			<p class="o-apoio">{{ h.cards.texto }}</p>
		</div>
		<div class="o-cards-servico" data-o-holofote>
		{%- for s in conteudo.servicos %}
			{{ ui.cardServico(s, "h3") }}
		{%- endfor %}
		</div>
	</div>
</section>

<section class="o-sec o-alertas o-escolher-sec o-ctx-preto" data-secao="como-escolher" aria-labelledby="escolher-titulo">
	<div class="o-fundo o-fundo--linhas" aria-hidden="true"></div>
	<div class="o-wrap">
		<div class="o-alertas__cabeca">
			<div>
				<p class="o-etiqueta">{{ h.escolher.etiqueta }}</p>
				<h2 class="o-titulo o-titulo--g" id="escolher-titulo">{{ h.escolher.titulo }}</h2>
			</div>
		</div>
		<ul class="o-escolher">
		{%- for item in h.escolher.situacoes %}
			{%- set alvo = conteudo.servicoPorSlug[item.servico] %}
			<li class="o-escolher__item o-janela">
				<div class="o-janela__barra" aria-hidden="true"><span class="o-janela__titulo">situacao_0{{ loop.index }}.txt</span><span class="o-janela__ctrl"></span></div>
				<div class="o-janela__corpo">
					<p class="o-escolher__situacao">{{ item.situacao }}</p>
					<p class="o-escolher__porque">{{ item.porque }}</p>
					<a class="o-link-seta" href="/servicos/{{ alvo.slug }}/">Comece por {{ alvo.nome | lower }} <span class="o-icone o-icone--seta" aria-hidden="true"></span></a>
				</div>
			</li>
		{%- endfor %}
		</ul>
		<p class="o-escolher__nao-sei">{{ h.escolher.nao_sei }} <a class="o-link-seta" href="#orcamento">Pedir o Raio-X <span class="o-icone o-icone--seta" aria-hidden="true"></span></a></p>
	</div>
</section>

<section class="o-sec o-ctx-branco o-combinacoes-sec" data-secao="combinacoes" aria-labelledby="combinacoes-titulo">
	<div class="o-wrap">
		<div class="o-vitrine__cabeca">
			<div>
				<p class="o-etiqueta">{{ h.combinacoes.etiqueta }}</p>
				<h2 class="o-titulo o-titulo--g" id="combinacoes-titulo">{{ h.combinacoes.titulo }}</h2>
			</div>
			<p class="o-apoio">{{ h.combinacoes.texto }}</p>
		</div>
		<ul class="o-combinacoes">
		{%- for c in h.combinacoes.itens %}
			<li class="o-combinacao o-janela">
				<div class="o-janela__barra" aria-hidden="true"><span class="o-janela__titulo">{{ c.janela }}</span><span class="o-janela__ctrl"></span></div>
				<div class="o-janela__corpo o-combinacao__corpo">
					<p class="o-combinacao__plano">{{ c.plano }}</p>
					<h3 class="o-combinacao__nome">{{ c.nome }}</h3>
					<p class="o-combinacao__preco">{% if c.de %}<span>{{ c.de }}</span> {% endif %}<strong>{{ c.valor }}</strong></p>
					<p class="o-combinacao__texto">{{ c.texto }}</p>
					<a class="o-btn o-btn--contorno o-combinacao__botao" href="#orcamento" data-o-plano="{{ c.plano | lower | replace(' ', '-') }}" data-servicos="{{ c.servicos | join(' ') }}">{{ h.combinacoes.botao }}<span class="o-sr"> ({{ c.plano }})</span></a>
				</div>
			</li>
		{%- endfor %}
		</ul>
		<p class="o-combinacoes__mais"><span class="o-planos__nota">{{ conteudo.planos.nota }}</span> <a class="o-link-seta" href="{{ h.combinacoes.link.url }}" data-cta="hub-planos">{{ h.combinacoes.link.texto }} <span class="o-icone o-icone--seta" aria-hidden="true"></span></a></p>
	</div>
</section>

{% include "secoes/orcamento.njk" %}
