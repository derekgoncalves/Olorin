---
layout: layouts/base.njk
modo: sobre
slug: sobre
og_imagem: /assets/img/og/sobre.jpg
pessoasSchema: true
migalhas:
  - { nome: Home, url: / }
  - { nome: Sobre, url: /sobre/ }
eleventyComputed:
  titulo: "{{ conteudo.paginas.sobre.seo.titulo }}"
  descricao: "{{ conteudo.paginas.sobre.seo.descricao }}"
---
{#- Página Sobre — textos em src/content/paginas/sobre.yml e src/content/equipe.yml. -#}
{%- import "components/ui.njk" as ui with context -%}
{%- set p = conteudo.paginas.sobre -%}
<section class="o-pagina-topo o-ctx-preto" data-secao="sobre-hero">
	<div class="o-wrap o-pagina-topo__grade">
		<div class="o-pagina-topo__texto">
			{{ ui.migalhas(migalhas) }}
			<p class="o-etiqueta">{{ p.etiqueta }}</p>
			<h1 class="o-pagina-topo__titulo">{{ p.titulo }}</h1>
			<p class="o-pagina-topo__sub">{{ p.sub }}</p>
		</div>
		<figure class="o-sobre-foto o-janela">
			<div class="o-janela__barra" aria-hidden="true"><span class="o-janela__titulo">bastidores.jpg</span><span class="o-janela__ctrl"></span></div>
			{{ imagem(imagens, "sobre-bastidores", { prioridade: true, sizes: "(max-width: 960px) 88vw, 420px" }) | safe }}
		</figure>
	</div>
</section>

<section class="o-sec o-ctx-branco" data-secao="historia" aria-labelledby="historia-titulo">
	<div class="o-wrap o-duas-colunas">
		<h2 class="o-titulo o-titulo--g" id="historia-titulo">{{ p.historia.titulo }}</h2>
		<div>
			{%- for par in p.historia.paragrafos %}<p class="o-apoio">{{ par }}</p>{% endfor %}
			<p class="o-sobre-lema">{{ p.historia.lema }}</p>
		</div>
	</div>
</section>

<section class="o-sec o-equipe o-ctx-preto" id="equipe" data-secao="equipe" aria-labelledby="equipe-titulo">
	<div class="o-wrap">
		<h2 class="o-titulo o-titulo--g" id="equipe-titulo">{{ p.equipe.titulo }}</h2>
		<div class="o-equipe__grade">
		{%- for pessoa in conteudo.equipe.pessoas %}
			<article class="o-pessoa" id="{{ pessoa.slug }}">
				<figure class="o-pessoa__foto o-janela">
					<div class="o-janela__barra" aria-hidden="true"><span class="o-janela__titulo">{{ pessoa.janela }}</span><span class="o-janela__ctrl"></span></div>
					{{ imagem(imagens, pessoa.foto, { sizes: "(max-width: 640px) 88vw, (max-width: 1100px) 44vw, 380px" }) | safe }}
				</figure>
				<div class="o-pessoa__texto">
					<h3 class="o-pessoa__nome">{{ pessoa.nome }}</h3>
					<p class="o-pessoa__funcao">{{ pessoa.funcao }}</p>
					<p class="o-pessoa__frase">{{ pessoa.bio }}</p>
					{%- set servicosPessoa = [] -%}
					<ul class="o-pessoa__servicos" aria-label="Serviços em que atua">
					{%- for sl in pessoa.servicos %}{% set sv = conteudo.servicoPorSlug[sl] %}{% if sv %}<li><a href="/servicos/{{ sv.slug }}/">{{ sv.nome }}</a></li>{% endif %}{% endfor %}
					</ul>
				</div>
			</article>
		{%- endfor %}
		</div>
	</div>
</section>

<section class="o-sec o-metodo o-ctx-violeta" id="metodo" data-secao="metodo" aria-labelledby="metodo-titulo">
	<div class="o-wrap o-metodo__grade">
		<div class="o-metodo__cabeca">
			<p class="o-etiqueta">Método Olorin</p>
			<h2 class="o-titulo o-titulo--g" id="metodo-titulo">{{ p.metodo.titulo }}</h2>
			<p class="o-apoio">{{ p.metodo.texto }}</p>
		</div>
		<ol class="o-etapas" data-o-etapas>
		{%- for e in conteudo.home.metodo.etapas %}
			<li class="o-etapa"><span class="o-etapa__num" aria-hidden="true">0{{ loop.index }}</span><h3 class="o-etapa__nome">{{ e.nome }}</h3><p class="o-etapa__texto">{{ e.texto }}</p></li>
		{%- endfor %}
		</ol>
	</div>
</section>

<section class="o-sec o-ctx-preto" data-secao="remoto" aria-labelledby="remoto-titulo">
	<div class="o-wrap o-duas-colunas">
		<h2 class="o-titulo o-titulo--g" id="remoto-titulo">{{ p.remoto.titulo }}</h2>
		<ul class="o-lista-pixel">{% for i in p.remoto.itens %}<li>{{ i | confirmar | safe }}</li>{% endfor %}</ul>
	</div>
	<div class="o-wrap o-sobre-contato">
		<p class="o-faixa-cta__texto">{{ p.contato.titulo }}</p>
		<a class="o-btn o-btn--verde" href="{{ waLink('sobre', { tipo: 'equipe' }) }}" target="_blank" rel="noopener"><span class="o-icone o-icone--whatsapp" aria-hidden="true"></span>{{ p.contato.botao }}</a>
	</div>
</section>

{%- set origemWaForm = "sobre-form" -%}
{%- set origemWaFinal = "sobre-final" -%}
{% include "secoes/orcamento.njk" %}
