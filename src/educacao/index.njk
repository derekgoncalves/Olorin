---
layout: layouts/base.njk
modo: home
modo_form: educacao
slug: educacao
tema: educacao
cabecalho: educacao
permalink: /educacao/
og_imagem: /assets/img/og/home.jpg
fontes_extra:
  - { href: /assets/fonts/educacao/fraunces-900.woff2, tipo: font/woff2 }
---
{#-
	/educacao/ — LP "Olorin Educação": marca própria dentro do site (mesma logo e cores, mais violeta),
	com caderno quadriculado, tinta de mimeógrafo, lousa, carimbo e janelas .exe.
	Textos: src/content/paginas/educacao.yml · cases: cases.yml · preços: planos.yml · equipe: equipe.yml
	Visual: src/styles/componentes/educacao.css · interações: src/scripts/modulos/educacao.js
-#}
{%- set E = conteudo.paginas.educacao -%}
{%- set cfg = site.config -%}
{%- from "components/formulario.njk" import formulario with context -%}
{%- set svgRisco -%}<svg class="o-edu-risco" viewBox="0 0 200 24" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path pathLength="1" d="M4 14C46 7 118 5 196 9"/><path pathLength="1" d="M28 20C80 15 136 13 180 16"/></svg>{%- endset -%}
{%- set svgOval -%}<svg class="o-edu-oval" viewBox="0 0 120 60" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path pathLength="1" d="M66 7C26 3 5 16 6 31c1 17 36 24 68 21 32-3 44-15 39-29C108 9 82 3 46 9"/></svg>{%- endset -%}

{#- ===== 1. Banner: violeta, caderno quadriculado e boletim do Raio-X ===== -#}
{%- set h = E.hero -%}
<section class="o-sec o-edu-hero o-ctx-violeta o-com-grao" id="inicio" data-secao="hero" aria-labelledby="edu-titulo">
	<div class="o-edu-fundo o-edu-fundo--hero" aria-hidden="true" data-o-edu-lapis><span class="o-edu-tinta"></span></div>
	<div class="o-wrap o-edu-hero__grade">
		<div class="o-edu-hero__texto">
			<p class="o-etiqueta">{{ h.etiqueta }}</p>
			<h1 class="o-edu-h1" id="edu-titulo">{{ h.titulo }} <span class="o-edu-sublinhado">{{ h.titulo_destaque }}{{ svgRisco | safe }}</span></h1>
			<p class="o-edu-hero__lead">{{ h.texto }}</p>
			{#- Atalho: o WhatsApp digitado aqui vai para o formulário do Raio-X. Sem JS, só leva até ele. -#}
			<form class="o-edu-atalho" action="#raio-x" method="get" data-o-atalho="form-raio-x" novalidate>
				<label class="o-edu-atalho__rotulo" for="edu-atalho-whatsapp">{{ h.atalho.rotulo }}</label>
				<div class="o-edu-atalho__linha">
					<input class="o-edu-atalho__campo" id="edu-atalho-whatsapp" type="tel" inputmode="tel" autocomplete="tel-national" maxlength="20" placeholder="{{ h.atalho.placeholder }}" aria-describedby="edu-atalho-ajuda">
					<button class="o-btn o-btn--branco o-edu-atalho__botao" id="cta-diagnostico-hero" type="submit">{{ h.atalho.botao }} <span class="o-icone o-icone--seta" aria-hidden="true"></span></button>
				</div>
				<p class="o-edu-atalho__ajuda" id="edu-atalho-ajuda"><span class="o-icone o-icone--relogio" aria-hidden="true"></span>{{ h.atalho.ajuda }}</p>
			</form>
			<p class="o-edu-hero__wa"><a class="o-link-wa" id="cta-whatsapp-hero" href="{{ waLink('educacao-hero', { mensagem: E.whatsapp.padrao }) }}" target="_blank" rel="noopener"><span class="o-icone o-icone--whatsapp" aria-hidden="true"></span>{{ h.link_whatsapp }}</a></p>
			<ul class="o-edu-prova" aria-label="Como a Olorin Educação trabalha">
			{%- for item in h.prova %}
				<li>{{ item }}</li>
			{%- endfor %}
			</ul>
		</div>
		<div class="o-edu-hero__visual">
			{%- set b = h.boletim %}
			<figure class="o-janela o-edu-boletim o-ctx-branco">
				<div class="o-janela__barra" aria-hidden="true"><span class="o-janela__titulo">{{ b.janela }}</span><span class="o-janela__ctrl"></span></div>
				<div class="o-edu-boletim__corpo">
					<p class="o-edu-boletim__topo"><strong>{{ b.titulo }}</strong><span>{{ b.escola }} · {{ b.periodo }}</span></p>
					<table class="o-edu-boletim__tabela">
						<caption class="o-sr">{{ b.titulo }}: notas de exemplo por canal</caption>
						<thead><tr><th scope="col">{{ b.coluna_materia }}</th><th scope="col">{{ b.coluna_nota }}</th></tr></thead>
						<tbody>
						{%- for m in b.materias %}
							<tr{% if m.alerta %} class="is-alerta"{% endif %} style="--k: {{ loop.index0 }}">
								<th scope="row">{{ m.nome }}{% if m.obs %}<small>{{ m.obs }}</small>{% endif %}</th>
								<td>{% if m.nota == "?" %}<span aria-hidden="true">?</span><span class="o-sr">sem nota</span>{% else %}<span class="o-edu-boletim__nota">{{ m.nota }}{% if loop.index0 == 3 %}{{ svgOval | safe }}{% endif %}</span>{% endif %}</td>
							</tr>
						{%- endfor %}
						</tbody>
					</table>
					<p class="o-edu-carimbo o-edu-carimbo--boletim" aria-hidden="true">{{ b.carimbo }}</p>
				</div>
				<figcaption class="o-edu-aviso">{{ b.aviso }}</figcaption>
			</figure>
			<span class="o-edu-pixels" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
		</div>
	</div>
</section>

{#- ===== 2. Régua (faixa animada) ===== -#}
<div class="o-faixa o-edu-regua o-ctx-branco" data-o-faixa>
	<ul class="o-faixa__trilho">
	{%- for item in E.regua %}
		<li>{{ item }}</li>
	{%- endfor %}
	</ul>
	<button class="o-faixa__pausar" type="button" aria-pressed="false" data-o-pausar><span class="o-sr" data-o-pausar-texto>Pausar animações</span><span class="o-faixa__pausar-icone" aria-hidden="true"></span></button>
</div>

{#- ===== 3. Para quem é: lista de chamada ===== -#}
{%- set t = E.chamada -%}
<section class="o-sec o-edu-sec o-edu-papel o-ctx-branco" id="para-quem" data-secao="para-quem" aria-labelledby="edu-para-quem-titulo">
	<div class="o-wrap o-edu-duas">
		<div class="o-edu-cabeca">
			<p class="o-etiqueta">{{ t.etiqueta }}</p>
			<h2 class="o-edu-h2" id="edu-para-quem-titulo">{{ t.titulo }}</h2>
			<p class="o-edu-apoio">{{ t.texto }}</p>
			<p class="o-edu-local"><span class="o-icone o-icone--pixel" aria-hidden="true"></span>{{ t.nota }}</p>
		</div>
		<div class="o-janela o-edu-chamada" data-o-edu-entra>
			<div class="o-janela__barra" aria-hidden="true"><span class="o-janela__titulo">{{ t.janela }}</span><span class="o-janela__ctrl"></span></div>
			<div class="o-edu-chamada__corpo">
				<p class="o-edu-chamada__topo" aria-hidden="true"><span>nº</span><span>{{ t.turma }}</span></p>
				<ol class="o-edu-chamada__lista" role="list">
				{%- for item in t.itens %}
					<li style="--k: {{ loop.index0 }}"><span class="o-edu-chamada__num" aria-hidden="true">{{ "0" + loop.index if loop.index < 10 else loop.index }}</span><span class="o-edu-chamada__nome">{{ item }}</span><span class="o-edu-chamada__marca" aria-hidden="true">{{ t.presente }}</span></li>
				{%- endfor %}
				</ol>
				<p class="o-edu-chamada__ausente"><span class="o-edu-chamada__marca o-edu-chamada__marca--ausente">{{ t.ausente }}:</span> {{ t.ausente_texto }}</p>
			</div>
		</div>
	</div>
</section>

{#- ===== 4. Onde a matrícula escapa: lousa com a correção ===== -#}
{%- set t = E.lousa -%}
<section class="o-sec o-edu-sec o-edu-lousa o-ctx-preto" id="sinais" data-secao="sinais" aria-labelledby="edu-sinais-titulo">
	<div class="o-edu-lousa__po" aria-hidden="true" data-o-edu-apagador></div>
	<div class="o-wrap">
		<div class="o-edu-cabeca o-edu-cabeca--linha">
			<div>
				<p class="o-etiqueta">{{ t.etiqueta }}</p>
				<h2 class="o-edu-h2" id="edu-sinais-titulo">{{ t.titulo }}</h2>
			</div>
			<p class="o-edu-apoio">{{ t.texto }}</p>
		</div>
		<ol class="o-edu-erros" role="list" data-o-edu-entra>
		{%- for item in t.itens %}
			<li class="o-edu-erro" style="--k: {{ loop.index0 }}">
				<span class="o-edu-erro__num" aria-hidden="true">{{ "0" + loop.index if loop.index < 10 else loop.index }}</span>
				<p class="o-edu-erro__texto">{{ item.erro }}</p>
				<p class="o-edu-erro__certo"><span class="o-sr">{{ t.correcao }} </span><span class="o-edu-erro__caneta">{{ item.certo }}{{ svgRisco | safe }}</span></p>
			</li>
		{%- endfor %}
		</ol>
		<div class="o-edu-faixa-cta">
			<p>{{ t.cta_texto }}</p>
			<a class="o-btn o-btn--verde" href="#raio-x" data-cta="edu-sinais-raio-x">{{ t.cta }} <span class="o-icone o-icone--seta" aria-hidden="true"></span></a>
		</div>
	</div>
</section>

{#- ===== 5. Calendário de captação ===== -#}
{%- set t = E.calendario -%}
{%- set naTemporada = (t.meses | filtrarPor("mes", mesBuild)).length > 0 -%}
<section class="o-sec o-edu-sec o-edu-papel o-ctx-branco" id="calendario" data-secao="calendario" aria-labelledby="edu-calendario-titulo">
	<div class="o-wrap">
		<div class="o-edu-cabeca o-edu-cabeca--linha">
			<div>
				<p class="o-etiqueta">{{ t.etiqueta }}</p>
				<h2 class="o-edu-h2" id="edu-calendario-titulo">{{ t.titulo }}</h2>
			</div>
			<p class="o-edu-apoio">{{ t.texto }}</p>
		</div>
		<div class="o-janela o-edu-calendario" data-o-edu-calendario data-o-edu-entra>
			<div class="o-janela__barra" aria-hidden="true"><span class="o-janela__titulo">{{ t.janela }}</span><span class="o-janela__ctrl"></span></div>
			<ol class="o-edu-meses" role="list">
			{%- for m in t.meses %}
				<li class="o-edu-mes{% if m.pico %} o-edu-mes--pico{% endif %}" data-mes="{{ m.mes }}"{% if m.mes == mesBuild %} aria-current="date"{% endif %} style="--k: {{ loop.index0 }}">
					<p class="o-edu-mes__nome"><span aria-hidden="true">{{ m.curto }}</span><span class="o-sr">{{ m.nome }}</span></p>
					<p class="o-edu-mes__fase">{{ m.fase }}</p>
					<p class="o-edu-mes__texto">{{ m.texto }}</p>
					<p class="o-edu-mes__turma" aria-hidden="true">{% for i in range(0, t.vagas) %}<i{% if i < m.turma %} class="is-on"{% endif %}></i>{% endfor %}</p>
					{%- if m.mes == mesBuild %}
					<p class="o-edu-aqui" data-o-edu-aqui>{{ t.aqui }}</p>
					{%- endif %}
				</li>
			{%- endfor %}
			</ol>
			{%- if not naTemporada %}
			<p class="o-edu-aqui" data-o-edu-aqui hidden>{{ t.aqui }}</p>
			{%- endif %}
			<div class="o-edu-calendario__pe">
				<p class="o-edu-calendario__legenda"><span class="o-edu-calendario__vaga" aria-hidden="true"></span>{{ t.turma_legenda }}</p>
				<p class="o-edu-calendario__fora" data-o-edu-fora{% if naTemporada %} hidden{% endif %}>{{ t.fora }}</p>
			</div>
		</div>
		<p class="o-edu-nota">{{ t.nota }}</p>
	</div>
</section>

{#- ===== 6. Raio-X gratuito: teste de atendimento + formulário (etapa 1) ===== -#}
{%- set t = E.raio_x -%}
<section class="o-sec o-edu-sec o-edu-raio o-ctx-violeta o-com-grao" id="raio-x" data-secao="raio-x" aria-labelledby="edu-raio-titulo">
	<div class="o-edu-fundo o-edu-fundo--raio" aria-hidden="true"><span class="o-edu-varredura"></span></div>
	<div class="o-wrap o-edu-raio__grade">
		<div class="o-edu-cabeca o-edu-raio__texto">
			<p class="o-etiqueta">{{ t.etiqueta }}</p>
			<h2 class="o-edu-h2" id="edu-raio-titulo">{{ t.titulo }}</h2>
			<p class="o-edu-apoio">{{ t.texto }}</p>
			<ol class="o-edu-passos" role="list">
			{%- for p in t.passos %}
				<li><span class="o-edu-passos__num" aria-hidden="true">{{ "0" + loop.index }}</span><span>{{ p }}</span></li>
			{%- endfor %}
			</ol>
			<ul class="o-lista-pixel o-edu-raio__lista">
			{%- for item in t.itens %}<li>{{ item }}</li>{% endfor %}
			</ul>
		</div>
		<div class="o-edu-dado">
			<p class="o-edu-dado__texto">{{ t.dado.antes }} <strong>{{ t.dado.numero }}</strong> {{ t.dado.depois }}</p>
			<p class="o-edu-dado__fonte">Fonte: <a href="{{ t.dado.fonte_url }}" target="_blank" rel="noopener">{{ t.dado.fonte }}<span class="o-sr"> (abre em nova aba)</span></a></p>
		</div>
		{{ formulario({ id: "form-raio-x", posicao: "topo", modo: "educacao", origemWa: "educacao-form-raio-x", nomeServico: E.whatsapp.assunto_form }) }}
	</div>
</section>

{#- ===== 7. Método e funil até o custo por matrícula ===== -#}
{%- set t = E.metodo -%}
{%- set f = t.funil -%}
<section class="o-sec o-edu-sec o-edu-papel o-ctx-branco" id="metodo" data-secao="metodo" aria-labelledby="edu-metodo-titulo">
	<div class="o-wrap">
		<div class="o-edu-cabeca o-edu-cabeca--linha">
			<div>
				<p class="o-etiqueta">{{ t.etiqueta }}</p>
				<h2 class="o-edu-h2" id="edu-metodo-titulo">{{ t.titulo }}</h2>
			</div>
			<p class="o-edu-apoio">{{ t.texto }}</p>
		</div>
		<div class="o-edu-metodo">
			<ol class="o-edu-etapas" role="list">
			{%- for etapa in t.etapas %}
				<li class="o-edu-etapa">
					<span class="o-edu-etapa__num" aria-hidden="true">{{ "0" + loop.index }}</span>
					<h3 class="o-edu-etapa__nome">{{ etapa.nome }}</h3>
					<p class="o-edu-etapa__texto">{{ etapa.texto }}</p>
				</li>
			{%- endfor %}
			</ol>
			<figure class="o-janela o-edu-funil" data-o-edu-entra>
				<div class="o-janela__barra" aria-hidden="true"><span class="o-janela__titulo">{{ f.janela }}</span><span class="o-janela__ctrl"></span></div>
				<div class="o-edu-funil__corpo">
					<p class="o-edu-funil__topo"><strong>{{ f.titulo }}</strong><span>{{ f.verba }}</span></p>
					<ol class="o-edu-funil__lista" role="list">
					{%- for etapa in f.etapas %}
						<li style="--v: {{ (etapa.valor / f.etapas[0].valor) | round(3) }}; --k: {{ loop.index0 }}"><span class="o-edu-funil__rotulo">{{ etapa.rotulo }}</span><span class="o-edu-funil__valor">{{ etapa.valor }}</span><span class="o-edu-funil__barra" aria-hidden="true"></span></li>
					{%- endfor %}
					</ol>
					<p class="o-edu-funil__resultado"><span>{{ f.resultado_rotulo }}</span> <strong>{{ f.resultado }}{{ svgOval | safe }}</strong></p>
					<p class="o-edu-funil__glossario">{{ f.glossario }}</p>
				</div>
				<figcaption class="o-edu-aviso">{{ f.aviso }}</figcaption>
			</figure>
		</div>
		<p class="o-edu-centro"><a class="o-btn o-btn--violeta" href="#raio-x" data-cta="edu-metodo-raio-x">{{ t.cta }} <span class="o-icone o-icone--seta" aria-hidden="true"></span></a></p>
	</div>
</section>

{#- ===== 8. Cases: fichas da iZETA e do Dr. José Anacleto Abduch ===== -#}
{%- set t = E.cases -%}
<section class="o-sec o-edu-sec o-edu-cases o-ctx-violeta o-com-grao" id="cases" data-secao="cases" aria-labelledby="edu-cases-titulo">
	<div class="o-edu-fundo o-edu-fundo--cases" aria-hidden="true"></div>
	<div class="o-wrap">
		<div class="o-edu-cabeca o-edu-cabeca--linha">
			<div>
				<p class="o-etiqueta">{{ t.etiqueta }}</p>
				<h2 class="o-edu-h2" id="edu-cases-titulo">{{ t.titulo }}</h2>
			</div>
			<p class="o-edu-apoio">{{ t.texto }}</p>
		</div>
		<div class="o-edu-fichas">
		{%- for c in conteudo.casesTodos %}{% if c.edu %}
			<article class="o-janela o-edu-ficha o-ctx-branco" id="case-{{ c.slug }}" aria-labelledby="edu-case-{{ c.slug }}" data-o-edu-entra>
				<div class="o-janela__barra" aria-hidden="true"><span class="o-janela__titulo">{{ c.janela }}</span><span class="o-janela__ctrl"></span></div>
				<div class="o-edu-ficha__corpo">
					<div class="o-edu-ficha__topo">
						<img class="o-edu-ficha__logo" src="/assets/img/clientes/{{ c.logo }}" alt="" width="{{ c.edu.logo_largura }}" height="48" loading="lazy" decoding="async">
						<p class="o-edu-ficha__num" aria-hidden="true">{{ t.ficha }} {{ "0" + loop.index if loop.index < 10 else loop.index }}</p>
					</div>
					<h3 class="o-edu-ficha__nome" id="edu-case-{{ c.slug }}">{{ c.edu.nome }}</h3>
					<dl class="o-edu-ficha__campos">
					{%- for campo in c.edu.campos %}
						<div><dt>{{ campo.rotulo }}</dt><dd>{{ campo.valor }}</dd></div>
					{%- endfor %}
						<div><dt>{{ t.rotulos.fizemos }}</dt><dd>{{ c.resumo }}</dd></div>
						<div><dt>{{ t.rotulos.servicos }}</dt><dd>{{ c.servicos_texto }}</dd></div>
						<div class="o-edu-ficha__resultado"><dt>{{ t.rotulos.resultado }}</dt><dd>{{ c.edu.resultado }}</dd></div>
					</dl>
					<p class="o-edu-ficha__site"><a class="o-edu-link" href="{{ c.edu.site }}" target="_blank" rel="noopener">{{ t.site }}: {{ c.edu.site_texto }}<span class="o-sr"> (abre em nova aba)</span></a></p>
					<p class="o-edu-carimbo o-edu-carimbo--ficha" aria-hidden="true">{{ t.carimbo }}</p>
				</div>
			</article>
		{%- endif %}{% endfor %}
		</div>
	</div>
</section>

{#- ===== 9. Quem coordena ===== -#}
{%- set t = E.equipe -%}
<section class="o-sec o-edu-sec o-edu-lousa o-edu-equipe o-ctx-preto" id="equipe" data-secao="equipe" aria-labelledby="edu-equipe-titulo">
	<div class="o-wrap">
		<div class="o-edu-cabeca o-edu-cabeca--linha">
			<div>
				<p class="o-etiqueta">{{ t.etiqueta }}</p>
				<h2 class="o-edu-h2" id="edu-equipe-titulo">{{ t.titulo }}</h2>
			</div>
			<p class="o-edu-apoio">{{ t.texto }}</p>
		</div>
		<ul class="o-edu-pessoas" role="list">
		{%- for p in conteudo.equipe.pessoas %}
			<li class="o-edu-pessoa">
				<figure class="o-janela o-edu-pessoa__foto">
					<div class="o-janela__barra" aria-hidden="true"><span class="o-janela__titulo">{{ p.janela }}</span><span class="o-janela__ctrl"></span></div>
					{{ imagem(imagens, p.foto, { sizes: "(max-width: 767px) 36vw, (max-width: 1100px) 30vw, 380px" }) | safe }}
				</figure>
				<h3 class="o-edu-pessoa__nome"><a href="/quem-somos/#{{ p.slug }}">{{ p.nome }}</a></h3>
				<p class="o-edu-pessoa__cargo">{{ p.cargo or p.funcao }}</p>
				<p class="o-edu-pessoa__frase">{{ t.frases[p.slug] or p.frase }}</p>
			</li>
		{%- endfor %}
		</ul>
		<p class="o-edu-acoes">
			<a class="o-btn o-btn--verde" id="cta-whatsapp-equipe" href="{{ waLink('educacao-equipe', { mensagem: E.whatsapp.equipe }) }}" target="_blank" rel="noopener"><span class="o-icone o-icone--whatsapp" aria-hidden="true"></span>{{ t.botao }}</a>
			<a class="o-link-seta" href="/quem-somos/">{{ t.link_sobre }} <span class="o-icone o-icone--seta" aria-hidden="true"></span></a>
		</p>
	</div>
</section>

{#- ===== 10. Preços: os mesmos planos do site, em forma de carnê ===== -#}
{%- set t = E.planos -%}
{%- set P = conteudo.planos -%}
<section class="o-sec o-edu-sec o-edu-papel o-ctx-branco" id="planos" data-secao="planos" aria-labelledby="edu-planos-titulo">
	<div class="o-wrap">
		<div class="o-edu-cabeca o-edu-cabeca--linha">
			<div>
				<p class="o-etiqueta">{{ t.etiqueta }}</p>
				<h2 class="o-edu-h2" id="edu-planos-titulo">{{ t.titulo }}</h2>
			</div>
			<p class="o-edu-apoio">{{ t.texto }}</p>
		</div>
		<ul class="o-edu-planos" role="list">
		{%- for plano in P.planos %}
			<li class="o-edu-plano{% if plano.destaque %} o-edu-plano--destaque o-ctx-violeta{% endif %}" data-plano="{{ plano.id }}">
				<p class="o-edu-plano__topo"><span class="o-edu-plano__carne" aria-hidden="true">{{ t.carne }} · {{ "0" + loop.index }}</span>{% if plano.tag %}<span class="o-edu-plano__tag">{{ plano.tag }}</span>{% endif %}</p>
				<h3 class="o-edu-plano__nome">{{ plano.nome }}</h3>
				<p class="o-edu-plano__para">{{ t.para[plano.id] or plano.para }}</p>
				<p class="o-edu-plano__preco"><span class="o-edu-plano__de">{{ plano.de or P.preco_fechado }}</span> <strong class="o-edu-plano__valor">{{ plano.valor | reais }}</strong> <span class="o-edu-plano__periodo">{{ plano.periodo }}</span></p>
				<ul class="o-lista-pixel o-edu-plano__itens">
				{%- for item in plano.itens %}<li>{{ item }}</li>{% endfor %}
				</ul>
				<p class="o-edu-plano__selos">{% for selo in (plano.selos or []) %}<span>{{ selo }}</span>{% endfor %}</p>
				<p class="o-edu-plano__extra">{{ plano.implantacao or "" }}{% if plano.custo_total and cfg.SHOW_TOTAL_COST %}{% if plano.implantacao %}<br>{% endif %}{{ plano.custo_total }}{% endif %}</p>
				<a class="o-btn {{ 'o-btn--branco' if plano.destaque else 'o-btn--violeta' }} o-edu-plano__botao" href="#orcamento" data-o-plano="{{ plano.id }}" data-servicos="{{ plano.servicos_preselecao | join(' ') }}" data-cta="edu-planos-{{ plano.id }}">{{ P.botao }}<span class="o-sr"> — {{ plano.nome }}</span></a>
			</li>
		{%- endfor %}
		</ul>
		<div class="o-edu-planos__notas">
			<p>{{ P.nota }}</p>
			<p>{{ P.contrato }}</p>
			<p><strong>{{ t.projetos }}</strong> {% for pj in P.projetos.itens %}{{ pj.nome }} {{ pj.de | lower }} {{ pj.valor | reais }}{% if not loop.last %} · {% endif %}{% endfor %}. <a class="o-edu-link" href="{{ P.projetos.link.url }}">{{ P.projetos.link.texto }}</a></p>
		</div>
	</div>
</section>

{#- ===== 11. Dúvidas ===== -#}
{%- set t = E.duvidas -%}
<section class="o-sec o-edu-sec o-edu-lousa o-edu-faq o-ctx-preto" id="duvidas" data-secao="duvidas" aria-labelledby="edu-duvidas-titulo">
	<div class="o-edu-lousa__po" aria-hidden="true" data-o-edu-apagador></div>
	<div class="o-wrap o-edu-faq__grade">
		<div class="o-edu-cabeca o-edu-faq__cabeca">
			<p class="o-etiqueta">{{ t.etiqueta }}</p>
			<h2 class="o-edu-h2" id="edu-duvidas-titulo">{{ t.titulo }}</h2>
			<p class="o-edu-apoio">{{ t.texto }}</p>
			<a class="o-btn o-btn--contorno" id="cta-whatsapp-duvidas" href="{{ waLink('educacao-duvidas', { mensagem: E.whatsapp.duvida }) }}" target="_blank" rel="noopener"><span class="o-icone o-icone--whatsapp" aria-hidden="true"></span>{{ t.botao }}</a>
		</div>
		<div class="o-edu-faq__lista">
		{%- for item in E.faq %}
			<details class="o-edu-faq__item" id="{{ item.id }}" data-o-faq="{{ item.id }}"{% if loop.first %} open{% endif %}>
				<summary class="o-edu-faq__pergunta"><span>{{ item.pergunta }}</span><span class="o-edu-faq__mais" aria-hidden="true"></span></summary>
				<div class="o-edu-faq__resposta"><p>{{ item.resposta | emLinha | safe }}</p></div>
			</details>
		{%- endfor %}
		</div>
	</div>
</section>

{#- ===== 12. Chamada final + formulário completo ===== -#}
{%- set t = E.orcamento -%}
<section class="o-sec o-edu-sec o-edu-final o-ctx-violeta o-com-grao" id="orcamento" data-secao="orcamento" aria-labelledby="edu-final-titulo">
	<div class="o-edu-fundo o-edu-fundo--final" aria-hidden="true" data-o-edu-lapis><span class="o-edu-final__palavra">turma</span></div>
	<div class="o-wrap">
		<div class="o-edu-cabeca">
			<p class="o-etiqueta">{{ t.etiqueta }}</p>
			<h2 class="o-edu-h2 o-edu-h2--g" id="edu-final-titulo">{{ t.titulo }}</h2>
		</div>
		<div class="o-edu-final__grade">
			{{ formulario({ id: "form-fim", posicao: "fim", modo: "educacao", origemWa: "educacao-form-fim", nomeServico: E.whatsapp.assunto_form }) }}
			<div class="o-edu-final__lado">
				<ul class="o-lista-pixel o-edu-final__lista">
				{%- for item in t.lista %}<li>{{ item }}</li>{% endfor %}
				</ul>
				<div class="o-janela o-edu-final__wa">
					<div class="o-janela__barra" aria-hidden="true"><span class="o-janela__titulo">{{ t.janela }}</span><span class="o-janela__ctrl"></span></div>
					<div class="o-janela__corpo">
						<p class="o-edu-final__wa-etiqueta">{{ t.wa_etiqueta }}</p>
						<p>{{ t.wa_texto }}:</p>
						<p class="o-edu-final__telefone"><a id="cta-whatsapp-final" href="{{ waLink('educacao-orcamento-final', { mensagem: E.whatsapp.padrao }) }}" target="_blank" rel="noopener"><span class="o-icone o-icone--whatsapp" aria-hidden="true"></span>{{ cfg.TELEFONE_EXIBICAO }}</a></p>
					</div>
				</div>
				<p class="o-edu-final__lema">{{ E.marca.lema }} <span>{{ E.marca.apoio }}</span></p>
			</div>
		</div>
	</div>
</section>
