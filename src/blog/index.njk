---
layout: layouts/base.njk
modo: hub
slug: blog
pagina_dados: blog
permalink: /blog/
og_imagem: /assets/img/og/blog.jpg
blogSchema: true
migalhas:
  - { nome: Home, url: / }
  - { nome: Blog, url: /blog/ }
eleventyComputed:
  titulo: "{{ conteudo.paginas.blog.seo.titulo }}"
  descricao: "{{ conteudo.paginas.blog.seo.descricao }}"
---
{#- Página /blog/: todos os artigos, separados por categoria (ordem alfabética; dentro de cada uma, do mais novo
    para o mais antigo). Textos em src/content/paginas/blog.yml; artigos em src/blog/artigos/ (ver docs/BLOG.md). -#}
{%- import "components/ui.njk" as ui with context -%}
{%- import "components/blog.njk" as blog with context -%}
{%- set B = conteudo.paginas.blog -%}
{%- set categorias = collections.blogCategorias or [] -%}
<section class="o-pagina-topo o-blog-topo o-ctx-preto" data-secao="blog-hero">
	<div class="o-fundo o-fundo--colunas" aria-hidden="true" data-o-fundo><div class="o-fundo__luz"></div><b></b><b></b><b></b><b></b><b></b></div>
	<div class="o-wrap">
		{{ ui.migalhas(migalhas) }}
		<p class="o-etiqueta">{{ B.etiqueta }}</p>
		<h1 class="o-pagina-topo__titulo">{{ B.titulo }}</h1>
		<p class="o-pagina-topo__sub">{{ B.sub }}</p>
		{%- if categorias.length %}
		<nav class="o-blog-cats" aria-label="{{ B.categorias_rotulo }}">
			<ul>
			{%- for cat in categorias %}
				<li><a class="o-blog-cat" href="#categoria-{{ cat.slug }}">{{ cat.nome }} <span class="o-blog-cat__num"><span class="o-sr">(</span>{{ cat.artigos.length }}<span class="o-sr"> {{ B.um_artigo if cat.artigos.length == 1 else B.varios_artigos }})</span></span></a></li>
			{%- endfor %}
			</ul>
		</nav>
		{%- endif %}
	</div>
</section>
{%- for cat in categorias %}
<section class="o-sec o-sec--compacta o-blog-categoria o-ctx-branco" id="categoria-{{ cat.slug }}" data-secao="blog-categoria" aria-labelledby="categoria-{{ cat.slug }}-titulo">
	<div class="o-wrap">
		<div class="o-blog-categoria__cabeca">
			<p class="o-etiqueta">{{ B.categoria_etiqueta }}</p>
			<h2 class="o-titulo o-titulo--m" id="categoria-{{ cat.slug }}-titulo">{{ cat.nome }}</h2>
			<p class="o-blog-categoria__conta">{{ cat.artigos.length }} {{ B.um_artigo if cat.artigos.length == 1 else B.varios_artigos }}</p>
		</div>
		<div class="o-blog-grade">
		{%- for item in cat.artigos %}
			{{ blog.card(item.data.artigo, "h3") }}
		{%- endfor %}
		</div>
		{%- if loop.last %}
		<p class="o-blog-feed"><a href="/blog/feed.xml">{{ B.feed }}</a></p>
		{%- endif %}
	</div>
</section>
{%- else %}
<section class="o-sec o-sec--compacta o-ctx-branco" data-secao="blog-vazio">
	<div class="o-wrap"><p class="o-apoio">{{ B.vazio }}</p></div>
</section>
{%- endfor %}
{%- set origemWaForm = "blog-form" -%}
{%- set origemWaFinal = "blog-final" -%}
{% include "secoes/orcamento.njk" %}
