---
permalink: /blog/feed.xml
eleventyExcludeFromCollections: true
---
{#- Feed Atom do blog (leitores de RSS): título, resumo, data e autor de cada artigo. -#}
{%- set cfg = site.config -%}
{%- set artigos = collections.artigos or [] -%}
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="pt-BR">
	<title>Blog da Olorin</title>
	<subtitle>{{ conteudo.paginas.blog.seo.descricao | escaparXml }}</subtitle>
	<link href="{{ '/blog/feed.xml' | urlAbsoluta }}" rel="self" type="application/atom+xml"/>
	<link href="{{ '/blog/' | urlAbsoluta }}" rel="alternate" type="text/html"/>
	<id>{{ '/blog/' | urlAbsoluta }}</id>
	<updated>{{ (artigos[0].data.artigo.atualizado or artigos[0].data.artigo.data) if artigos.length else cfg.ATUALIZADO_EM }}T09:00:00-03:00</updated>
	<author><name>{{ cfg.NOME }}</name></author>
	<icon>{{ '/assets/img/brand/icon-192.png' | urlAbsoluta }}</icon>
{%- for item in artigos %}
{%- set a = item.data.artigo %}
	<entry>
		<title>{{ a.titulo | escaparXml }}</title>
		<link href="{{ a.url | urlAbsoluta }}" rel="alternate" type="text/html"/>
		<id>{{ a.url | urlAbsoluta }}</id>
		<published>{{ a.data }}T09:00:00-03:00</published>
		<updated>{{ a.atualizado or a.data }}T09:00:00-03:00</updated>
		<author><name>{{ a.autor.nome | escaparXml }}</name><uri>{{ ('/quem-somos/' + a.autor.slug + '/') | urlAbsoluta }}</uri></author>
		<category term="{{ a.categoriaSlug }}" label="{{ a.categoria | escaparXml }}"/>
		<summary>{{ a.descricao | escaparXml }}</summary>
	</entry>
{%- endfor %}
</feed>
