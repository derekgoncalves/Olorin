---
layout: layouts/base.njk
modo: hub
slug: planos
pagina_dados: planos
og_imagem: /assets/img/og/home.jpg
migalhas:
  - { nome: Home, url: / }
  - { nome: Planos, url: /planos/ }
eleventyComputed:
  titulo: "{{ conteudo.paginas.planos.seo.titulo }}"
  descricao: "{{ conteudo.paginas.planos.seo.descricao }}"
---
{#- Página Planos e preços — textos em src/content/paginas/planos.yml; valores em src/content/planos.yml; dúvidas em src/content/faq.yml. -#}
{%- import "components/ui.njk" as ui with context -%}
{%- set h = conteudo.paginas.planos -%}
<section class="o-pagina-topo o-ctx-preto" data-secao="planos-hero">
	<div class="o-wrap">
		{{ ui.migalhas(migalhas) }}
		<p class="o-etiqueta">{{ h.etiqueta }}</p>
		<h1 class="o-pagina-topo__titulo">{{ h.titulo }}</h1>
		<p class="o-pagina-topo__sub">{{ h.sub }}</p>
		<div class="o-hero__acoes">
			<a class="o-btn o-btn--verde o-btn--grande" id="cta-diagnostico-planos" href="#orcamento">{{ conteudo.home.hero.botao if site.config.OFERTA_DIAGNOSTICO else conteudo.home.hero.botao_sem_diagnostico }}</a>
			<a class="o-link-wa" href="{{ waLink('planos-hero') }}" target="_blank" rel="noopener"><span class="o-icone o-icone--whatsapp" aria-hidden="true"></span>{{ conteudo.home.hero.link_whatsapp }}</a>
		</div>
	</div>
</section>
{% include "secoes/planos.njk" %}
{% include "secoes/duvidas.njk" %}
{%- set origemWaForm = "planos-form" -%}
{%- set origemWaFinal = "planos-final" -%}
{% include "secoes/orcamento.njk" %}
