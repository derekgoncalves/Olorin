---
permalink: /site.webmanifest
eleventyExcludeFromCollections: true
---
{{ {
	name: site.config.NOME,
	short_name: "Olorin",
	description: site.config.LEMA,
	lang: "pt-BR",
	start_url: "/",
	display: "browser",
	background_color: "#000000",
	theme_color: "#000000",
	icons: [
		{ src: "/assets/img/brand/icon-192.png", sizes: "192x192", type: "image/png" },
		{ src: "/assets/img/brand/icon-512.png", sizes: "512x512", type: "image/png" },
		{ src: "/assets/img/brand/favicon.svg", sizes: "any", type: "image/svg+xml" }
	]
} | dump(2) | safe }}
