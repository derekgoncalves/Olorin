{#- Cabeçalho das landings de campanha: só logo e o botão do Raio-X, que leva ao formulário do topo (sem menu, sem saídas). -#}
{%- import "components/ui.njk" as ui with context -%}
<header class="o-topo o-topo--minimo" data-o-topo>
	<div class="o-topo__dentro">
		<span class="o-logo" role="img" aria-label="Olorin Digital"><svg viewBox="0 0 731 125.6" aria-hidden="true" focusable="false"><use href="#s-logo"></use></svg></span>
		{{ ui.botaoRaioX("cta-orcamento-topo", "Raio-X grátis" if site.config.OFERTA_DIAGNOSTICO else "Pedir orçamento", "o-btn--pequeno o-topo__unico", "#formulario") }}
	</div>
</header>
