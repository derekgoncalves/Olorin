{#- Cabeçalho das landings de campanha: só logo e um botão (sem menu, sem saídas). -#}
<header class="o-topo o-topo--minimo" data-o-topo>
	<div class="o-topo__dentro">
		<span class="o-logo" role="img" aria-label="Olorin Digital"><svg viewBox="0 0 731 125.6" aria-hidden="true" focusable="false"><use href="#s-logo"></use></svg></span>
		<a class="o-btn o-btn--verde o-btn--pequeno o-topo__unico" id="cta-orcamento-topo" href="#formulario">{{ "Quero meu Raio-X" if site.config.OFERTA_DIAGNOSTICO else "Pedir orçamento" }}</a>
	</div>
</header>
