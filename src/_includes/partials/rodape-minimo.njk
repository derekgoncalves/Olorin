{#- Rodapé das landings de campanha: só o essencial (sem links de saída além de WhatsApp e Política). -#}
{%- set cfg = site.config -%}
{%- set temRastreamento = cfg.GTM_ID or cfg.GA4_ID or cfg.META_PIXEL_ID -%}
<footer class="o-rodape o-rodape--minimo">
	<div class="o-wrap o-rodape__base-dentro">
		<p>{{ cfg.NOME }} © 2026 · {{ cfg.CIDADE }}, {{ cfg.UF }} · <a href="{{ waLink('promo-rodape') }}" target="_blank" rel="noopener" id="cta-whatsapp-rodape">WhatsApp {{ cfg.TELEFONE_EXIBICAO }}</a></p>
		<p>
			<a href="/politica-de-privacidade/">Política de Privacidade</a>
			{%- if temRastreamento %} · <button type="button" data-o-cookies-abrir>Preferências de cookies</button>{% endif %}
			· <button class="o-pausar" type="button" aria-pressed="false" data-o-pausar><span data-o-pausar-texto>Pausar animações</span></button>
		</p>
	</div>
</footer>
