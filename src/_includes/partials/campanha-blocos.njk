{#- Blocos comuns às landings de campanha (/promo/ e /promo/<slug>/), abaixo do banner com o formulário.
    17/10/2026: barra de logos de clientes e, na landing do serviço, "Este é o seu caso?" com o botão do Raio-X;
    na landing geral, a chamada final. Sem preço, método e dúvidas. Espera: servicoCampanha (slug ou vazio).
    18/10/2026: a barra de logos é o pé do banner preto de cima (mesmo fundo, emendada nele). -#}
{%- import "components/ui.njk" as ui with context -%}
{%- set pc = conteudo.paginas.promo -%}
{%- set faixa_pe = true -%}
{%- set faixa_ctx = "preto" -%}
{% include "secoes/faixa-clientes.njk" %}
{%- set s = conteudo.servicoPorSlug[servicoCampanha] if servicoCampanha else null -%}
{%- if s and s.dores and s.dores.itens.length %}
{%- set idCta = "cta-raio-x-promo-" + s.slug + "-caso" -%}
{%- set destinoCta = "#formulario" -%}
{% include "partials/servico-dores.njk" %}
{%- else %}
<section class="o-sec o-sec--compacta o-ctx-preto o-promo-final" data-secao="cta-final">
	<div class="o-wrap o-promo-final__dentro">
		<p class="o-faixa-cta__texto">{{ pc.cta_final.titulo }}</p>
		{{ ui.botaoRaioX("cta-raio-x-promo-final", pc.cta_final.botao, "o-btn--grande", "#formulario") }}
	</div>
</section>
{%- endif %}
