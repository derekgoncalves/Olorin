{#- Rodapé da LP Olorin Educação: marca, lema, segmentos e contato.
    Textos: paginas/educacao.yml → marca, cabecalho e rodape. -#}
{%- set cfg = site.config -%}
{%- set E = conteudo.paginas.educacao -%}
{%- set r = E.rodape -%}
{%- import "components/ui.njk" as ui with context -%}
{%- set temRastreamento = cfg.GTM_ID or cfg.GA4_ID or cfg.META_PIXEL_ID -%}
<footer class="o-rodape o-edu-rodape">
	<div class="o-wrap o-edu-rodape__grade">
		<div class="o-edu-rodape__marca">
			<a class="o-edu-marca" href="#inicio" aria-label="{{ E.marca.nome }}, voltar ao início da página">
				<svg class="o-edu-marca__logo" viewBox="0 0 731 125.6" aria-hidden="true" focusable="false"><use href="#s-logo"></use></svg>
				<span class="o-edu-marca__sub" aria-hidden="true">{{ E.marca.sub }}</span>
			</a>
			<p class="o-edu-rodape__lema">{{ E.marca.lema }}</p>
			<p class="o-edu-rodape__apoio">{{ E.marca.apoio }}</p>
			<p class="o-edu-rodape__parte">{{ E.marca.parte_de }}</p>
			{{ ui.redes("o-edu-rodape__redes", "rodape-educacao") }}
		</div>
		{#- Rodapé enxuto (dono, 24/10/2026): como o do site, só Segmentos e Contato. -#}
		{%- for item in navegacao.principal %}{% if item.submenu == "segmentos" and item.itens %}
		<nav class="o-edu-rodape__col" aria-label="{{ item.rotulo }}">
			<p class="o-rodape__titulo">{{ item.rotulo }}</p>
			<ul>
			{%- for sub in item.itens %}
				<li><a href="{{ sub.url }}">{{ sub.rotulo }}</a></li>
			{%- endfor %}
			</ul>
		</nav>
		{%- endif %}{% endfor %}
		<div class="o-edu-rodape__col">
			<p class="o-rodape__titulo">{{ r.contato }}</p>
			<ul>
				<li><a href="{{ waLink('educacao-rodape', { mensagem: E.whatsapp.padrao }) }}" target="_blank" rel="noopener" id="cta-whatsapp-rodape">WhatsApp {{ cfg.TELEFONE_EXIBICAO }}</a></li>
				<li><a href="mailto:{{ cfg.EMAIL }}">{{ cfg.EMAIL }}</a></li>
				<li>{{ E.cabecalho.remoto }}</li>
			</ul>
		</div>
	</div>
	<div class="o-edu-rodape__gigante" aria-hidden="true"><span>{{ E.marca.sub }}</span></div>
	<div class="o-rodape__base">
		<div class="o-wrap o-rodape__base-dentro">
			<p>{{ cfg.NOME }} © 2026 · CNPJ {{ cfg.CNPJ }}</p>
			<p>
				<a href="/politica-de-privacidade/">Política de Privacidade</a>
				{#- Escondido sem IDs de medição; o main.js mostra quando há algum. -#}
			<span data-o-cookies-link{% if not temRastreamento %} hidden{% endif %}> · <button type="button" data-o-cookies-abrir>Preferências de cookies</button></span>
				· <button class="o-pausar" type="button" aria-pressed="false" data-o-pausar><span data-o-pausar-texto>Pausar animações</span></button>
			</p>
		</div>
	</div>
</footer>
