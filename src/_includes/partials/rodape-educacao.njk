{#- Rodapé completo. -#}
{%- set cfg = site.config -%}
{%- import "components/ui.njk" as ui with context -%}
{%- set temRastreamento = cfg.GTM_ID or cfg.GA4_ID or cfg.META_PIXEL_ID -%}
<footer class="o-rodape">
	<div class="o-wrap o-rodape__grade">
		<div class="o-rodape__marca">
			<a class="o-rodape__logo" href="/" aria-label="Olorin Digital — página inicial"><svg viewBox="0 0 731 125.6" aria-hidden="true" focusable="false"><use href="#s-logo"></use></svg></a>
			<p>{{ cfg.LEMA }}</p>
			<p class="o-rodape__titulo o-redes__titulo">Siga a Olorin</p>
			{{ ui.redes("o-rodape__redes", "rodape") }}
		</div>
		<nav class="o-rodape__col" aria-label="Serviços">
			<p class="o-rodape__titulo">Serviços</p>
			<ul>
			{%- for s in conteudo.servicos %}
				<li><a href="/servicos/{{ s.slug }}/">{{ s.nome }}</a></li>
			{%- endfor %}
			</ul>
		</nav>
		<nav class="o-rodape__col" aria-label="A Olorin">
			<p class="o-rodape__titulo">A Olorin</p>
			<ul>
				<li><a href="/quem-somos/">Quem somos</a></li>
				<li><a href="/como-trabalhamos/">Como trabalhamos</a></li>
				<li><a href="/planos/">Planos e preços</a></li>
				{%- if conteudo.portfolioPublicado and conteudo.portfolioPublicado.length %}<li><a href="/portfolio/">Portfólio</a></li>{% endif %}
				<li><a href="/planos/#duvidas">Dúvidas</a></li>
				<li><a href="/politica-de-privacidade/">Política de Privacidade</a></li>
			</ul>
		</nav>
		<div class="o-rodape__col">
			<p class="o-rodape__titulo">Contato</p>
			<ul>
				<li><a href="{{ waLink('rodape') }}" target="_blank" rel="noopener" id="cta-whatsapp-rodape">WhatsApp {{ cfg.TELEFONE_EXIBICAO }}</a></li>
				<li><a href="mailto:{{ cfg.EMAIL }}">{{ cfg.EMAIL }}</a></li>
				{%- if cfg.GBP_URL %}
				<li><a href="{{ cfg.GBP_URL }}" target="_blank" rel="noopener">Avaliações no Google</a></li>
				{%- endif %}
				<li>{{ cfg.CIDADE }}, {{ cfg.UF }} · atendimento 100% remoto</li>
			</ul>
		</div>
	</div>
	<div class="o-rodape__gigante" aria-hidden="true"><svg viewBox="0 0 731 125.6" focusable="false"><use href="#s-logo"></use></svg></div>
	<div class="o-rodape__base">
		<div class="o-wrap o-rodape__base-dentro">
			<p>{{ cfg.NOME }} © 2026 · {{ cfg.CIDADE }}, {{ cfg.UF }}</p>
			<p>
				<a href="/politica-de-privacidade/">Política de Privacidade</a>
				{%- if temRastreamento %} · <button type="button" data-o-cookies-abrir>Preferências de cookies</button>{% endif %}
				· <button class="o-pausar" type="button" aria-pressed="false" data-o-pausar><span data-o-pausar-texto>Pausar animações</span></button>
			</p>
		</div>
	</div>
</footer>
