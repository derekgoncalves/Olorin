{#-
	Biblioteca de componentes (PROMPT seção 3.2). Importar com:
	{% import "components/ui.njk" as ui with context %}
-#}

{#- Janela anos 90 com barra de título tipo "nome_arquivo.ext". -#}
{% macro janela(titulo, classe="", tag="div", atributos="") %}
<{{ tag }} class="o-janela {{ classe }}"{{ (" " + atributos) | safe if atributos }}>
	<div class="o-janela__barra" aria-hidden="true"><span class="o-janela__titulo">{{ titulo }}</span><span class="o-janela__ctrl"></span></div>
	<div class="o-janela__corpo">{{ caller() }}</div>
</{{ tag }}>
{% endmacro %}

{#- Etiqueta em pixel, acima dos títulos. -#}
{% macro etiqueta(texto, classe="") %}<p class="o-etiqueta {{ classe }}">{{ texto }}</p>{% endmacro %}

{#- Card de serviço: o card inteiro é clicável por um único link no título (::after estendido).
    resumo=false: só ícone, nome e "Ver o serviço" (home). -#}
{% macro cardServico(s, nivel="h3", num=0, resumo=true) %}
<article class="o-card-servico{% if not resumo %} o-card-servico--curto{% endif %}" data-servico="{{ s.slug }}">
	<p class="o-card-servico__topo" aria-hidden="true"><span class="o-icone o-icone--{{ s.icone }} o-card-servico__icone"></span>{% if num %}<span class="o-card-servico__num">{{ "0" + num if num < 10 else num }}</span>{% endif %}</p>
	<{{ nivel }} class="o-card-servico__titulo"><a class="o-card-servico__link" href="/servicos/{{ s.slug }}/" data-o-card-servico="{{ s.slug }}">{{ s.card.titulo }}</a></{{ nivel }}>
	{%- if resumo %}
	<p class="o-card-servico__texto">{{ s.card.resumo }}</p>
	{%- endif %}
	<p class="o-card-servico__mais" aria-hidden="true">{{ conteudo.home.servicos.ver_detalhes }} <span class="o-icone o-icone--seta"></span></p>
</article>
{% endmacro %}

{#- Card de pessoa da equipe, com foto em moldura de janela. -#}
{% macro cardPessoa(p, nivel="h3", compacto=false, link="") %}
<article class="o-pessoa{% if compacto %} o-pessoa--compacta{% endif %}{% if link %} o-pessoa--link{% endif %}" id="{{ p.slug }}">
	<figure class="o-pessoa__foto o-janela">
		<div class="o-janela__barra" aria-hidden="true"><span class="o-janela__titulo">{{ p.janela }}</span><span class="o-janela__ctrl"></span></div>
		{{ imagem(imagens, p.foto + ("-quadrada" if compacto else ""), { sizes: "(max-width: 640px) 160px, 160px" if compacto else "(max-width: 640px) 88vw, (max-width: 1100px) 44vw, 380px" }) | safe }}
	</figure>
	<div class="o-pessoa__texto">
		<{{ nivel }} class="o-pessoa__nome">{% if link %}<a class="o-pessoa__link" href="{{ link }}">{{ p.nome }}</a>{% else %}{{ p.nome }}{% endif %}</{{ nivel }}>
		<p class="o-pessoa__funcao">{{ p.cargo or p.funcao }}</p>
		<p class="o-pessoa__frase">{{ p.frase }}</p>
		{%- if link %}<p class="o-pessoa__mais" aria-hidden="true">{{ conteudo.home.equipe.ver_perfil or "Ver perfil" }} <span class="o-icone o-icone--seta"></span></p>{% endif %}
	</div>
</article>
{% endmacro %}

{#- Acordeão de perguntas (<details>), mesma fonte do JSON-LD. -#}
{% macro faqLista(perguntas, classe="") %}
<div class="o-faq__lista {{ classe }}">
{%- for item in perguntas %}
	<details class="o-faq__item" id="{{ item.id }}" data-o-faq="{{ item.id }}"{% if loop.first %} open{% endif %}>
		<summary class="o-faq__pergunta">{{ item.pergunta | confirmar | safe }}</summary>
		<div class="o-faq__resposta"><p>{{ item.resposta | emLinha | confirmar | safe }}</p></div>
	</details>
{%- endfor %}
</div>
{% endmacro %}

{#- Trilha de navegação (Home › Serviços › Serviço). O JSON-LD BreadcrumbList sai do mesmo dado. -#}
{% macro migalhas(itens) %}
<nav class="o-migalhas" aria-label="Você está em">
	<ol>
	{%- for m in itens %}
		<li>{% if loop.last %}<span aria-current="page">{{ m.nome }}</span>{% else %}<a href="{{ m.url }}">{{ m.nome }}</a>{% endif %}</li>
	{%- endfor %}
	</ol>
</nav>
{% endmacro %}

{#- Calculadora da home (src/content/calculadora.yml): expectativa de investimento por mês, sem planos
    nem preços fechados. Cada resposta vale pontos; a soma escolhe uma das faixas. O botão do Raio-X leva
    ao formulário do fim (o JS marca os serviços e anota a conta na mensagem). Sem JavaScript, a tabela
    com todas as combinações fica visível. -#}
{% macro calculadora() %}
{%- set c = conteudo.calculadora -%}
{%- set pf = c.perguntas[0] -%}
{%- set pv = c.perguntas[1] -%}
{%- set soma0 = (((pf.opcoes | filtrarPor("marcada", true))[0] or pf.opcoes[0]).pontos or 0) + (((pv.opcoes | filtrarPor("marcada", true))[0] or pv.opcoes[0]).pontos or 0) -%}
<div class="o-calc" id="calculadora" data-o-calc data-faixas="{{ c.faixas | dump | escape }}">
	<div class="o-janela__barra" aria-hidden="true"><span class="o-janela__titulo">{{ c.janela }}</span><span class="o-janela__ctrl"></span></div>
	<div class="o-calc__corpo">
		<form class="o-calc__form" data-o-calc-form hidden>
		{%- for q in c.perguntas %}
			{%- set marcada = (q.opcoes | filtrarPor("marcada", true))[0] or q.opcoes[0] %}
			<fieldset class="o-calc__grupo">
				<legend>{{ q.rotulo }}</legend>
				<div class="o-calc__opcoes">
				{%- for op in q.opcoes %}
					<label class="o-chip o-chip--escuro o-chip--opcao"><input type="radio" name="calc-{{ q.id }}" value="{{ op.texto }}" data-pontos="{{ op.pontos or 0 }}"{% if op.servicos %} data-servicos="{{ op.servicos | join(' ') }}"{% endif %}{% if op.texto == marcada.texto %} checked{% endif %}><span>{{ op.texto }}</span></label>
				{%- endfor %}
				</div>
			</fieldset>
		{%- endfor %}
		</form>
		<div class="o-calc__recibo" data-o-calc-recibo hidden>
			<p class="o-calc__recibo-topo" aria-hidden="true"><span>{{ c.recibo_topo }}</span><span>{{ c.recibo_numero }}</span></p>
			<dl class="o-calc__linhas">
			{%- for q in c.perguntas %}
				{%- set marcada = (q.opcoes | filtrarPor("marcada", true))[0] or q.opcoes[0] %}
				<div><dt>{{ q.rotulo }}</dt><dd data-o-calc-linha="{{ q.id }}">{{ marcada.texto }}</dd></div>
			{%- endfor %}
			</dl>
			<output class="o-calc__resultado" aria-live="polite" data-o-calc-resultado>
				<span class="o-calc__rotulo-total">{{ c.resultado_rotulo }}</span>
				<span class="o-calc__total"><strong data-o-calc-total>{% for fx in c.faixas %}{% if soma0 <= fx.pontos_ate and (loop.first or soma0 > c.faixas[loop.index0 - 1].pontos_ate) %}{{ fx.valor | reais }}{% endif %}{% endfor %}</strong> <small>{{ c.resultado_sufixo }}</small></span>
			</output>
			<a class="o-btn o-btn--verde o-btn--raio o-calc__botao" id="cta-raio-x-home-calculadora" href="#raio-x" data-cta="cta-raio-x-home-calculadora" data-o-calc-botao data-mensagem="{{ c.mensagem }}"><span class="o-icone o-icone--raio" aria-hidden="true"></span>{{ c.botao }}</a>
		</div>
		<table class="o-calc__tabela" data-o-calc-tabela>
			<caption>{{ c.tabela_titulo }}</caption>
			<thead>
				<tr><th scope="col">{{ pv.rotulo }}</th>{% for f in pf.opcoes %}<th scope="col">{{ f.texto }}</th>{% endfor %}</tr>
			</thead>
			<tbody>
			{%- for v in pv.opcoes %}
				<tr><th scope="row">{{ v.texto }}</th>{% for f in pf.opcoes %}{% set soma = (v.pontos or 0) + (f.pontos or 0) %}<td>{% for fx in c.faixas %}{% if soma <= fx.pontos_ate and (loop.first or soma > c.faixas[loop.index0 - 1].pontos_ate) %}{{ fx.valor | reais }}{% endif %}{% endfor %}</td>{% endfor %}</tr>
			{%- endfor %}
			</tbody>
		</table>
		<p class="o-calc__aviso">{{ c.aviso }}</p>
	</div>
</div>
{% endmacro %}

{#- Redes sociais da Olorin (só as que têm endereço em config.json). Ícone + nome acessível. -#}
{% macro redes(classe="", origem="") %}
{%- set cfg = site.config -%}
{%- set lista = [
	{ nome: "Instagram", url: cfg.INSTAGRAM_URL, icone: "instagram" },
	{ nome: "Facebook", url: cfg.FACEBOOK_URL, icone: "facebook" },
	{ nome: "LinkedIn", url: cfg.LINKEDIN_URL, icone: "linkedin" },
	{ nome: "X (Twitter)", url: cfg.X_URL, icone: "x" }
] -%}
<ul class="o-redes {{ classe }}" aria-label="Redes sociais da Olorin">
{%- for r in lista %}{% if r.url %}
	<li><a class="o-redes__link" href="{{ r.url }}" target="_blank" rel="noopener me" data-cta="rede-{{ r.icone }}{% if origem %}-{{ origem }}{% endif %}"><span class="o-icone o-icone--{{ r.icone }}" aria-hidden="true"></span><span class="o-sr">{{ r.nome }} da Olorin (abre em nova aba)</span></a></li>
{%- endif %}{% endfor %}
</ul>
{% endmacro %}

{#- Botão do Raio-X: a chamada padrão do site. Leva ao formulário "RAIO X DA OLORIN" no fim da página (#raio-x). -#}
{% macro botaoRaioX(id, texto="Quero meu Raio-X grátis", classe="", destino="#raio-x") %}
<a class="o-btn o-btn--verde o-btn--raio {{ classe }}" id="{{ id }}" href="{{ destino }}" data-cta="{{ id }}"><span class="o-icone o-icone--raio" aria-hidden="true"></span>{{ texto }}</a>
{% endmacro %}
