{#- ===== SEÇÃO: Dúvidas (FAQ completa) — só na página /sobre/; perguntas em src/content/faq.yml (o mesmo texto vai para o JSON-LD) ===== -#}
{%- set P = conteudo.paginas[pagina_dados] if pagina_dados else conteudo.home -%}
{%- import "components/ui.njk" as ui with context -%}
{%- set t = P.duvidas -%}
<section class="o-sec o-faq o-ctx-branco" id="duvidas" data-secao="duvidas" aria-labelledby="duvidas-titulo">
	<div class="o-wrap o-faq__grade">
		<div class="o-faq__cabeca">
			<p class="o-etiqueta">{{ t.etiqueta }}</p>
			<h2 class="o-titulo o-titulo--g" id="duvidas-titulo">{{ t.titulo }}</h2>
			<p class="o-apoio">{{ t.texto }}</p>
			{{ ui.botaoRaioX("cta-raio-x-sobre-duvidas", classe="o-btn--preto") }}
		</div>
		<div>
		{%- set perguntas = conteudo.faq.perguntas -%}
		{%- if t.ids %}{% set perguntas = conteudo.faq.perguntas | filtrarIds(t.ids) %}{% endif %}
		{{ ui.faqLista(perguntas) }}
		</div>
	</div>
</section>
