{#- ===== SEÇÃO: Calculadora (home) — src/content/calculadora.yml =====
     Bilhete de orçamento: 3 perguntas, o bilhete lista o que a pessoa quer (sem nenhum valor) e o botão
     envia o orçamento por WhatsApp (dono, 23/10/2026). -#}
{%- import "components/ui.njk" as ui with context -%}
{%- set c = conteudo.calculadora -%}
<section class="o-sec o-calc-sec o-ctx-branco" id="orcamento-calculadora" data-secao="calculadora" aria-labelledby="calculadora-titulo">
	<div class="o-wrap">
		<div class="o-planos__cabeca">
			<div>
				<p class="o-etiqueta">{{ c.etiqueta }}</p>
				<h2 class="o-titulo o-titulo--g" id="calculadora-titulo">{{ c.titulo }}</h2>
			</div>
			<p class="o-apoio">{{ c.texto }}</p>
		</div>
		{{ ui.calculadora() }}
	</div>
</section>
