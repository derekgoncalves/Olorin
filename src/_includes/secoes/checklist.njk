{#- ===== SEÇÃO: Sinais de alerta — src/content/home.yml → checklist =====
     Janelas de "erro" que só informam (nada aqui é clicável nem parece caixa de marcar). -#}
{%- set P = conteudo.paginas[pagina_dados] if pagina_dados else conteudo.home -%}
{%- set c = P.checklist -%}
<section class="o-sec o-alertas o-ctx-preto" id="checklist" data-secao="checklist" aria-labelledby="checklist-titulo">
	<div class="o-fundo o-fundo--linhas" aria-hidden="true"></div>
	<div class="o-wrap">
		<div class="o-alertas__cabeca">
			<div>
				<p class="o-etiqueta">{{ c.etiqueta }}</p>
				<h2 class="o-titulo o-titulo--g" id="checklist-titulo">{{ c.titulo }}</h2>
			</div>
			{%- if c.texto %}<p class="o-apoio">{{ c.texto }}</p>{% endif %}
		</div>
		<ul class="o-alertas__lista">
		{%- for item in c.itens %}
			{%- set num = "0" + loop.index if loop.index < 10 else loop.index %}
			<li class="o-alerta o-janela">
				<div class="o-janela__barra" aria-hidden="true"><span class="o-janela__titulo">{{ item.janela or ("erro_" + num + ".exe") }}</span><span class="o-janela__ctrl"></span></div>
				<div class="o-janela__corpo o-alerta__corpo">
					<span class="o-alerta__icone" aria-hidden="true">!</span>
					<div>
						{%- if item.titulo %}<h3 class="o-alerta__titulo">{{ item.titulo }}</h3>{% endif %}
						<p class="o-alerta__texto">{{ item.texto or item }}</p>
					</div>
				</div>
			</li>
		{%- endfor %}
		</ul>
		<div class="o-alertas__resposta">
			<div>
				<p class="o-alertas__veredito">{{ c.resposta_titulo }}</p>
				<p class="o-alertas__solucao">{{ c.resposta }}</p>
			</div>
			<a class="o-btn o-btn--verde" href="{{ c.cta_destino or '#orcamento' }}" data-cta="checklist-resolver">{{ c.cta }} <span class="o-icone o-icone--seta" aria-hidden="true"></span></a>
		</div>
	</div>
</section>
