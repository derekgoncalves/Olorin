{#- ===== SEÇÃO: Faixa de logos de clientes (letreiro) — logos em src/content/clientes.yml,
     credencial da Natalia em src/content/home.yml → faixa_clientes =====
     Vai em todas as páginas: {% include "secoes/faixa-clientes.njk" %}. Fundo branco por padrão; para
     outro fundo, antes do include: {% set faixa_ctx = "preto" %} (preto, branco, verde ou violeta). -#}
{%- set cl = conteudo.clientes or {} -%}
{%- set logos = cl.itens or [] -%}
{%- set fc = conteudo.home.faixa_clientes or {} -%}
{%- set fctx = faixa_ctx if faixa_ctx in ["preto", "branco", "verde", "violeta"] else "branco" -%}
{%- if logos.length %}
<section class="o-sec o-clientes o-ctx-{{ fctx }}" data-secao="clientes" aria-labelledby="clientes-titulo">
	<h2 class="o-sr" id="clientes-titulo">{{ cl.etiqueta or "Marcas atendidas" }}</h2>
	<div class="o-faixa o-faixa--logos" data-o-faixa>
		<ul class="o-faixa__trilho">
		{%- for c in logos %}
			<li><img src="/assets/img/clientes/{{ c.logo }}" alt="{{ c.nome }}" loading="lazy" decoding="async" width="{{ c.largura or 120 }}" height="{{ c.altura or 40 }}" style="--logo-a: {{ c.altura or 40 }}"></li>
		{%- endfor %}
		</ul>
		<button class="o-faixa__pausar" type="button" aria-pressed="false" data-o-pausar><span class="o-sr" data-o-pausar-texto>Pausar animações</span><span class="o-faixa__pausar-icone" aria-hidden="true"></span></button>
	</div>
	{%- if fc.credencial_nome %}
	<p class="o-clientes__credencial o-wrap">
		<span class="o-clientes__selos"><img src="/assets/img/marcas/meta.svg" alt="" width="24" height="24" loading="lazy" decoding="async"><img src="/assets/img/marcas/google.svg" alt="" width="24" height="24" loading="lazy" decoding="async"></span>
		<span>{{ fc.credencial_antes }} <a href="{{ fc.credencial_link }}">{{ fc.credencial_nome }}</a>{{ fc.credencial_depois }}</span>
	</p>
	{%- endif %}
</section>
{%- endif %}
