{#- ===== SEÇÃO: Raio-X gratuito (bloco 4 da home) — mini formulário, etapa 1 — src/content/home.yml → formulario_topo ===== -#}
{%- set P = conteudo.paginas[pagina_dados] if pagina_dados else conteudo.home -%}
{%- from "components/formulario.njk" import formulario with context -%}
{%- set t = P.formulario_topo -%}
<section class="o-sec o-raio-x o-ctx-violeta" id="raio-x" data-secao="raio-x" aria-labelledby="raio-x-titulo">
	<div class="o-raio-x__scan" aria-hidden="true"></div>
	<div class="o-wrap o-raio-x__grade">
		<div class="o-sec-cabeca o-raio-x__texto">
			<p class="o-etiqueta">{{ t.etiqueta }}</p>
			<h2 class="o-titulo o-titulo--g" id="raio-x-titulo">{{ t.titulo }}</h2>
			<p class="o-apoio">{{ t.texto }}</p>
			{%- if t.passos %}
			<ol class="o-raio-x__passos">
			{%- for p in t.passos %}<li><span class="o-raio-x__num" aria-hidden="true">{{ p.num }}</span>{{ p.texto }}</li>{% endfor %}
			</ol>
			{%- endif %}
			<ul class="o-lista-pixel o-raio-x__lista">
			{%- for item in t.itens %}<li>{{ item }}</li>{% endfor %}
			</ul>
		</div>
		{{ formulario({ id: "form-raio-x", posicao: "topo", modo: modo_form or "home" }) }}
	</div>
</section>
