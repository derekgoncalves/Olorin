{#- ===== SEÇÃO: Planos + calculadora — src/content/planos.yml ===== -#}
{%- set P = conteudo.paginas[pagina_dados] if pagina_dados else conteudo.home -%}
{%- import "components/ui.njk" as ui with context -%}
{%- set t = P.planos -%}
{%- set p = conteudo.planos -%}
<section class="o-sec o-planos o-ctx-branco" id="planos" data-secao="planos" aria-labelledby="planos-titulo">
	<div class="o-wrap">
		<p class="o-etiqueta">{{ t.etiqueta }}</p>
		<h2 class="o-titulo o-titulo--g" id="planos-titulo">{{ t.titulo }}</h2>
		<p class="o-apoio">{{ t.texto }}</p>
		<div class="o-planos__grade">
		{%- for plano in p.planos %}
			{{ ui.cardPlano(plano) }}
		{%- endfor %}
		</div>
		<div class="o-planos__notas">
			<p class="o-planos__nota">{{ p.nota }}</p>
			<p class="o-planos__nota">{{ p.contrato }}</p>
			{%- if site.config.SHOW_TOTAL_COST %}<p class="o-planos__total">{{ p.total_entrada }}</p>{% endif %}
		</div>
		{%- if t.link_mais %}
		<p class="o-planos__mais"><a class="o-btn o-btn--contorno" href="{{ t.link_mais.url }}" data-cta="planos-ver-mais">{{ t.link_mais.texto }}</a></p>
		{%- endif %}
		{%- if not t.sem_calculadora %}{{ ui.calculadora() }}{% endif %}
	</div>
</section>
