{#- ===== SEÇÃO: Banner (hero) — textos em src/content/home.yml → hero ===== -#}
{%- set P = conteudo.paginas[pagina_dados] if pagina_dados else conteudo.home -%}
{%- set h = P.hero -%}
<section class="o-sec o-hero o-ctx-preto" id="inicio" data-secao="hero">
	{#- Fundo: grade de pixels que acende sob o mouse (desktop) e quadradinhos que sobem. -#}
	<div class="o-fundo o-fundo--pixels" aria-hidden="true" data-o-fundo><div class="o-fundo__luz"></div><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
	<div class="o-wrap o-hero__grade">
		<div class="o-hero__texto">
			<p class="o-etiqueta o-hero__linha">{{ h.linha_superior }}</p>
			{#- Título em 2 partes: a chamada (linha menor) e a promessa (maior, com o destaque verde). -#}
			<h1 class="o-hero__titulo"><span class="o-hero__t1">{{ h.titulo_1 }}</span> <span class="o-hero__t2">{{ h.titulo_2 }} <span class="o-hero__destaque">{{ h.titulo_destaque }}</span></span></h1>
			<p class="o-hero__paragrafo">{{ h.paragrafo }}</p>
			{%- if h.atalho %}
			{#- Atalho: o WhatsApp digitado aqui vai para o formulário do Raio-X (bloco 4). Sem JS, só leva até ele. -#}
			<form class="o-atalho" action="#raio-x" method="get" data-o-atalho="form-raio-x" novalidate>
				<label class="o-atalho__rotulo" for="atalho-whatsapp">{{ h.atalho.rotulo }}</label>
				<div class="o-atalho__linha">
					<input class="o-atalho__campo" id="atalho-whatsapp" type="tel" inputmode="tel" autocomplete="tel-national" maxlength="20" placeholder="{{ h.atalho.placeholder }}" aria-describedby="atalho-ajuda">
					<button class="o-btn o-btn--verde o-atalho__botao" id="cta-diagnostico-hero" type="submit">{{ h.atalho.botao }} <span class="o-icone o-icone--seta" aria-hidden="true"></span></button>
				</div>
				<p class="o-atalho__ajuda" id="atalho-ajuda"><span class="o-icone o-icone--relogio" aria-hidden="true"></span>{{ h.atalho.ajuda }}</p>
			</form>
			<p class="o-hero__wa"><a class="o-link-wa" id="cta-whatsapp-hero" href="{{ waLink('hero') }}" target="_blank" rel="noopener"><span class="o-icone o-icone--whatsapp" aria-hidden="true"></span>{{ h.link_whatsapp }}</a></p>
			{%- else %}
			<div class="o-hero__acoes">
				<a class="o-btn o-btn--verde o-btn--grande" id="cta-diagnostico-hero" href="{{ h.botao_destino or '#orcamento' }}">{{ h.botao if site.config.OFERTA_DIAGNOSTICO else h.botao_sem_diagnostico }}</a>
				<a class="o-link-wa" id="cta-whatsapp-hero" href="{{ waLink('hero') }}" target="_blank" rel="noopener"><span class="o-icone o-icone--whatsapp" aria-hidden="true"></span>{{ h.link_whatsapp }}</a>
			</div>
			{%- if h.microtexto %}<p class="o-nota"><span class="o-icone o-icone--relogio" aria-hidden="true"></span>{{ h.microtexto }}</p>{% endif %}
			{%- endif %}
			{%- if h.link_nicho %}
			<p class="o-hero__nicho"><a class="o-link-seta" id="cta-nicho-hero" href="{{ h.link_nicho.url }}">{{ h.link_nicho.texto }} <span class="o-icone o-icone--seta" aria-hidden="true"></span></a></p>
			{%- endif %}
			<ul class="o-prova" aria-label="Como a Olorin trabalha">
			{%- for item in h.prova %}
				<li>{{ item }}</li>
			{%- endfor %}
			</ul>
		</div>
		<div class="o-hero__visual">
			<figure class="o-celular">
				{{ imagem(imagens, "hero-celular", { prioridade: true, sizes: "(max-width: 640px) 168px, (max-width: 1100px) 30vw, 320px", classe: "o-celular__img" }) | safe }}
				<svg class="o-celular__logo o-celular__logo--topo" viewBox="0 0 731 125.6" aria-hidden="true" focusable="false"><use href="#s-logo"></use></svg>
				<svg class="o-celular__logo o-celular__logo--base" viewBox="0 0 731 125.6" aria-hidden="true" focusable="false"><use href="#s-logo"></use></svg>
			</figure>
			<div class="o-janela o-hero__janela" aria-hidden="true">
				<div class="o-janela__barra"><span class="o-janela__titulo">{{ h.janela }}</span><span class="o-janela__ctrl"></span></div>
				<div class="o-hero__barras"><i></i><i></i><i></i><i></i></div>
				<p class="o-hero__janela-rotulo">{{ h.janela_rotulo }} <span class="o-icone o-icone--seta"></span></p>
			</div>
		</div>
	</div>
</section>
