{#- ===== SEÇÃO: Banner (hero) da home, textos em src/content/home.yml → hero =====
     Tela de início de jogo (dono, 23/10/2026: "ta perfeito"), num fundo preto só: o "O" da Olorin girando
     como moeda, a etiqueta, o lema (h1), o minijogo 8-bit (canvas desenhado por src/scripts/modulos/jogo.js),
     o botão START do Raio-X (id cta-diagnostico-hero, usado na medição), a linha de apoio, os 3 itens com
     check e, no pé, a faixa de logos (secoes/faixa-clientes.njk). Visual em src/styles/componentes/hero.css.
     O selo "Level up" é um ::before do destaque (texto em data-selo): decoração, fora do texto do h1. -#}
{%- set P = conteudo.paginas[pagina_dados] if pagina_dados else conteudo.home -%}
{%- import "components/ui.njk" as ui with context -%}
{%- set h = P.hero -%}
<section class="o-sec o-hero o-ctx-preto" id="inicio" data-secao="hero" aria-labelledby="hero-titulo">
	<div class="o-wrap o-hero__palco">
		<div class="o-hero__texto">
			<div class="o-hero__moeda" aria-hidden="true"><svg viewBox="0 0 134 126" focusable="false"><use href="#s-o"></use></svg></div>
			<p class="o-etiqueta o-hero__linha">{{ h.linha_superior }}</p>
			<h1 class="o-hero__titulo" id="hero-titulo"><span class="o-hero__l1">{{ h.titulo }}</span> <span class="o-hero__destaque" data-selo="▲ {{ h.selo }}">{{ h.titulo_destaque }}</span></h1>
			{#- Minijogo (decoração): sem JS fica escondido, sem deixar buraco. -#}
			<div class="o-hero__jogo" aria-hidden="true" data-o-jogo>
				<div class="o-hero__tela"><canvas width="192" height="72"></canvas><span class="o-hero__aviso" data-o-jogo-aviso>{{ h.jogo_aviso }}</span></div>
			</div>
			{{ ui.botaoRaioX("cta-diagnostico-hero", h.botao_start, "o-hero__start") }}
			{%- if h.apoio %}
			<p class="o-hero__apoio">{{ h.apoio }}</p>
			{%- endif %}
			<ul class="o-prova o-hero__prova" aria-label="{{ h.checks_rotulo }}">
			{%- for item in h.checks %}
				<li>{{ item }}</li>
			{%- endfor %}
			</ul>
		</div>
	</div>
	{#- Faixa de logos de clientes no pé do banner (secoes/faixa-clientes.njk), no mesmo fundo preto. -#}
	{%- set faixa_pe = true %}
	{% include "secoes/faixa-clientes.njk" %}
</section>
