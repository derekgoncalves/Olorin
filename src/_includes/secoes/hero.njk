{#- ===== SEÇÃO: Banner (hero) — textos em src/content/home.yml → hero =====
     Enxuto (dono, 17/10/2026): etiqueta, título, UM botão do Raio-X (id cta-diagnostico-hero, usado na
     medição) e 2 provas. No celular a montagem do celular some e a faixa de logos, logo abaixo, toma o lugar. -#}
{%- set P = conteudo.paginas[pagina_dados] if pagina_dados else conteudo.home -%}
{%- import "components/ui.njk" as ui with context -%}
{%- set h = P.hero -%}
<section class="o-sec o-hero o-ctx-preto" id="inicio" data-secao="hero">
	{#- Fundo: grade de pixels que acende sob o mouse (desktop) e quadradinhos que sobem. -#}
	<div class="o-fundo o-fundo--pixels" aria-hidden="true" data-o-fundo><div class="o-fundo__luz"></div><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
	<div class="o-wrap o-hero__grade">
		<div class="o-hero__texto">
			<p class="o-etiqueta o-hero__linha">{{ h.linha_superior }}</p>
			<h1 class="o-hero__titulo"><span class="o-hero__t1">{{ h.titulo_1 }}</span> <span class="o-hero__t2">{{ h.titulo_2 }} <span class="o-hero__destaque">{{ h.titulo_destaque }}</span></span></h1>
			{#- O único botão do banner: o do Raio-X, num visor (cantos e brilho que varre o botão). -#}
			<div class="o-hero__cta o-visor">{{ ui.botaoRaioX("cta-diagnostico-hero", h.botao, "o-btn--grande o-hero__raio") }}</div>
			<ul class="o-prova" aria-label="Como a Olorin trabalha">
			{%- for item in h.prova %}
				<li>{{ item }}</li>
			{%- endfor %}
			</ul>
		</div>
		{#- Montagem decorativa: celular com a logo, cursor que clica, aviso de cliente novo e a janela do relatório. -#}
		<div class="o-hero__visual" aria-hidden="true">
			<figure class="o-celular">
				{{ imagem(imagens, "hero-celular", { alt: "", sizes: "(max-width: 1100px) 30vw, 340px", classe: "o-celular__img" }) | safe }}
				<svg class="o-celular__logo o-celular__logo--topo" viewBox="0 0 731 125.6" focusable="false"><use href="#s-logo"></use></svg>
				<svg class="o-celular__logo o-celular__logo--base" viewBox="0 0 731 125.6" focusable="false"><use href="#s-logo"></use></svg>
			</figure>
			<span class="o-hero__cursor"><span class="o-icone o-icone--trafego"></span></span>
			<p class="o-hero__aviso"><span class="o-icone o-icone--check"></span>{{ h.aviso_clique }}</p>
			<div class="o-janela o-hero__janela">
				<div class="o-janela__barra"><span class="o-janela__titulo">{{ h.janela }}</span><span class="o-janela__ctrl"></span></div>
				<div class="o-hero__barras"><i></i><i></i><i></i><i></i></div>
				<p class="o-hero__janela-rotulo">{{ h.janela_rotulo }} <span class="o-icone o-icone--seta"></span></p>
			</div>
		</div>
	</div>
</section>
