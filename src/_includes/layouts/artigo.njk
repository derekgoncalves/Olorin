---
layout: layouts/base.njk
---
{#- Página de cada artigo do blog (src/blog/artigos/<slug>.md).
    Dados do artigo: "artigo" (ver prepararArtigo em scripts/blog.mjs). Textos fixos: src/content/paginas/blog.yml → artigo. -#}
{%- import "components/ui.njk" as ui with context -%}
{%- import "components/blog.njk" as blog with context -%}
{%- set A = artigo -%}
{%- set T = conteudo.paginas.blog.artigo -%}
{%- set waArtigo = waLink("blog-" + A.slug, { mensagem: T.wa_mensagem | replace("{x}", A.titulo) }) -%}
<article class="o-artigo" aria-labelledby="artigo-titulo">
	<header class="o-pagina-topo o-artigo-topo o-ctx-preto" data-secao="artigo-topo">
		<div class="o-wrap">
			{{ ui.migalhas(migalhas) }}
			<p class="o-artigo-topo__categoria"><a href="/blog/#categoria-{{ A.categoriaSlug }}">{{ A.categoria }}</a></p>
			<h1 class="o-artigo-topo__titulo" id="artigo-titulo">{{ A.titulo }}</h1>
			<p class="o-artigo-topo__resumo">{{ A.descricao }}</p>
			<div class="o-artigo-meta">
				<a class="o-artigo-meta__autor" href="/quem-somos/{{ A.autor.slug }}/">
					{{ imagem(imagens, A.autor.foto + "-quadrada", { alt: "", sizes: "52px" }) | safe }}
					<span><span class="o-sr">{{ T.escrito_por }} </span><strong>{{ A.autor.nome }}</strong><small>{{ A.autor.funcao }}</small></span>
				</a>
				<p class="o-artigo-meta__dados">
					<time datetime="{{ A.data }}">{{ A.data | dataExtenso }}</time> · {{ A.minutos }} {{ T.leitura }}
					{%- if A.atualizado %}<br>{{ T.atualizado }} <time datetime="{{ A.atualizado }}">{{ A.atualizado | dataExtenso }}</time>{% endif %}
				</p>
			</div>
		</div>
	</header>
	<div class="o-artigo-capa">
		<div class="o-artigo-capa__dentro">{{ blog.capa(A, "(max-width: 1180px) 92vw, 1120px", true) }}</div>
	</div>
	<div class="o-artigo-corpo o-ctx-branco">
		<div class="o-prosa">
{{ content | imagensDoArtigo(imagens) | safe }}
		</div>
		<footer class="o-artigo-fim">
			<div class="o-autor">
				{{ imagem(imagens, A.autor.foto + "-quadrada", { alt: "", sizes: "88px" }) | safe }}
				<div>
					<p class="o-etiqueta">{{ T.escrito_por }}</p>
					<p class="o-autor__nome"><a href="/quem-somos/{{ A.autor.slug }}/">{{ A.autor.nome }}</a></p>
					<p class="o-autor__funcao">{{ A.autor.funcao }}</p>
					<p class="o-autor__bio">{{ A.autor.bio or A.autor.frase }}</p>
					<a class="o-link-seta" href="/quem-somos/{{ A.autor.slug }}/">{{ T.ver_perfil }}<span class="o-sr"> de {{ A.autor.nome }}</span> <span class="o-icone o-icone--seta" aria-hidden="true"></span></a>
				</div>
			</div>
			<aside class="o-janela o-artigo-cta o-ctx-violeta" aria-labelledby="artigo-cta-titulo">
				<div class="o-janela__barra" aria-hidden="true"><span class="o-janela__titulo">{{ T.cta_janela }}</span><span class="o-janela__ctrl"></span></div>
				<div class="o-janela__corpo">
					<p class="o-etiqueta">{{ T.cta_etiqueta }}</p>
					<h2 class="o-titulo o-titulo--m" id="artigo-cta-titulo">{{ T.cta_titulo }}</h2>
					<p class="o-artigo-cta__texto">{{ T.cta_texto }}</p>
					<div class="o-artigo-cta__acoes">
						<a class="o-btn o-btn--branco" href="#orcamento" data-cta="blog-artigo-raio-x">{{ T.cta_botao }}</a>
						<a class="o-btn o-btn--contorno" href="{{ waArtigo }}" target="_blank" rel="noopener"><span class="o-icone o-icone--whatsapp" aria-hidden="true"></span>{{ T.cta_whatsapp }}</a>
					</div>
				</div>
			</aside>
		</footer>
	</div>
</article>
{%- set relacionados = collections.artigos | leiaTambem(A.url, A.categoriaSlug, 2) %}
{%- if relacionados.length %}
<section class="o-sec o-sec--compacta o-leia o-ctx-branco" data-secao="leia-tambem" aria-labelledby="leia-titulo">
	<div class="o-wrap">
		<div class="o-leia__cabeca">
			<div>
				<p class="o-etiqueta">{{ T.leia_etiqueta }}</p>
				<h2 class="o-titulo" id="leia-titulo">{{ T.leia_titulo }}</h2>
			</div>
			<a class="o-link-seta" href="/blog/">{{ T.todos }} <span class="o-icone o-icone--seta" aria-hidden="true"></span></a>
		</div>
		<div class="o-blog-grade o-blog-grade--2">
		{%- for item in relacionados %}
			{{ blog.card(item.data.artigo, "h3", "(max-width: 900px) 92vw, 600px") }}
		{%- endfor %}
		</div>
	</div>
</section>
{%- endif %}
{%- set origemWaForm = "blog-" + A.slug + "-form" -%}
{%- set origemWaFinal = "blog-" + A.slug + "-final" -%}
{% include "secoes/orcamento.njk" %}
