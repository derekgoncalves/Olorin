---
layout: layouts/base.njk
modo: sobre
slug: quem-somos
og_imagem: /assets/img/og/sobre.jpg
pessoasSchema: true
migalhas:
  - { nome: Home, url: / }
  - { nome: Quem somos, url: /quem-somos/ }
eleventyComputed:
  titulo: "{{ conteudo.paginas.sobre.seo.titulo }}"
  descricao: "{{ conteudo.paginas.sobre.seo.descricao }}"
---
{#- Quem somos: textos em src/content/paginas/sobre.yml (o nome do arquivo é antigo; a página /sobre/ usa paginas/sobre-metodo.yml);
    pessoas em src/content/equipe.yml (perfis em perfil.njk). -#}
{%- import "components/ui.njk" as ui with context -%}
{%- set p = conteudo.paginas.sobre -%}
<section class="o-pagina-topo o-quem-topo o-ctx-preto" data-secao="sobre-hero">
	<div class="o-fundo o-fundo--pixels" aria-hidden="true" data-o-fundo><div class="o-fundo__luz"></div></div>
	<div class="o-wrap o-pagina-topo__grade">
		<div class="o-pagina-topo__texto">
			{{ ui.migalhas(migalhas) }}
			<p class="o-etiqueta">{{ p.etiqueta }}</p>
			<h1 class="o-pagina-topo__titulo">{{ p.titulo }}</h1>
			<p class="o-pagina-topo__sub">{{ p.sub }}</p>
			<div class="o-hero__acoes">
				{{ ui.botaoRaioX("cta-raio-x-quem-somos-hero", classe="o-btn--grande") }}
				<a class="o-link-wa" href="{{ waLink('sobre-hero', { tipo: 'equipe' }) }}" target="_blank" rel="noopener"><span class="o-icone o-icone--whatsapp" aria-hidden="true"></span>{{ p.whatsapp }}</a>
			</div>
		</div>
		<div class="o-quem-pilha">
			<ul class="o-quem-pilha__lista">
			{%- for pessoa in conteudo.equipe.pessoas %}
				<li class="o-quem-pilha__item">
					<a class="o-quem-janela o-janela" href="/quem-somos/{{ pessoa.slug }}/">
						<span class="o-janela__barra" aria-hidden="true"><span class="o-janela__titulo">{{ pessoa.janela }}</span><span class="o-janela__ctrl"></span></span>
						{{ imagem(imagens, pessoa.foto, { prioridade: loop.first, sizes: "(max-width: 960px) 48vw, 260px" }) | safe }}
						<span class="o-quem-janela__legenda"><strong>{{ pessoa.nome }}</strong><span>{{ pessoa.cargo or pessoa.funcao }}</span></span>
					</a>
				</li>
			{%- endfor %}
			</ul>
			<p class="o-quem-pilha__dica" aria-hidden="true"><span class="o-icone o-icone--pixel"></span>{{ p.dica_pilha }}</p>
		</div>
	</div>
	{#- Barra de logos de clientes no pé do banner, no mesmo fundo (secoes/faixa-clientes.njk) -#}
	{%- set faixa_pe = true %}
	{% include "secoes/faixa-clientes.njk" %}
</section>

<section class="o-sec o-ctx-branco o-quem-historia" data-secao="historia" aria-labelledby="historia-titulo">
	<div class="o-wrap o-quem-historia__grade">
		<div class="o-quem-historia__cabeca">
			<p class="o-etiqueta">{{ p.historia.etiqueta }}</p>
			<h2 class="o-titulo o-titulo--gg" id="historia-titulo">{{ p.historia.titulo }}</h2>
			<p class="o-quem-historia__apoio">{{ p.historia.apoio }}</p>
		</div>
		<div class="o-quem-historia__texto">
			{%- for par in p.historia.paragrafos %}<p>{{ par }}</p>{% endfor %}
			{%- if p.historia.educacao %}
			<p class="o-quem-historia__edu"><span class="o-icone o-icone--o" aria-hidden="true"></span><span>{{ p.historia.educacao.texto }} <a class="o-link-seta" href="{{ p.historia.educacao.link.url }}">{{ p.historia.educacao.link.texto }} <span class="o-icone o-icone--seta" aria-hidden="true"></span></a></span></p>
			{%- endif %}
		</div>
	</div>
</section>

<section class="o-sec o-equipe o-quem-equipe o-ctx-preto" id="equipe" data-secao="equipe" aria-labelledby="equipe-titulo">
	<div class="o-wrap">
		<div class="o-servicos__cabeca">
			<div>
				<p class="o-etiqueta">{{ p.equipe.etiqueta }}</p>
				<h2 class="o-titulo o-titulo--g" id="equipe-titulo">{{ p.equipe.titulo }}</h2>
			</div>
			<p class="o-apoio">{{ p.equipe.texto }}</p>
		</div>
		<div class="o-equipe__grade">
		{%- for pessoa in conteudo.equipe.pessoas %}
			<article class="o-pessoa o-pessoa--link" id="{{ pessoa.slug }}">
				<figure class="o-pessoa__foto o-janela">
					<div class="o-janela__barra" aria-hidden="true"><span class="o-janela__titulo">{{ pessoa.janela }}</span><span class="o-janela__ctrl"></span></div>
					{{ imagem(imagens, pessoa.foto, { sizes: "(max-width: 640px) 44vw, (max-width: 1100px) 44vw, 380px" }) | safe }}
				</figure>
				<div class="o-pessoa__texto">
					<h3 class="o-pessoa__nome"><a class="o-pessoa__link" href="/quem-somos/{{ pessoa.slug }}/">{{ pessoa.nome }}</a></h3>
					<p class="o-pessoa__funcao">{{ pessoa.cargo or pessoa.funcao }}</p>
					<p class="o-pessoa__frase">{{ pessoa.bio }}</p>
					<ul class="o-pessoa__servicos" aria-label="Frentes que coordena">
					{%- for sl in pessoa.servicos %}{% set sv = conteudo.servicoPorSlug[sl] %}{% if sv %}<li><a href="/servicos/{{ sv.slug }}/">{{ sv.nome }}</a></li>{% endif %}{% endfor %}
					</ul>
					<p class="o-pessoa__mais" aria-hidden="true">{{ conteudo.home.equipe.ver_perfil or "Ver perfil" }} <span class="o-icone o-icone--seta"></span></p>
				</div>
			</article>
		{%- endfor %}
		</div>
	</div>
</section>

<section class="o-sec o-ctx-branco o-quem-jeito" data-secao="jeito" aria-labelledby="jeito-titulo">
	<div class="o-wrap">
		<div class="o-vitrine__cabeca">
			<div>
				<p class="o-etiqueta">{{ p.jeito.etiqueta }}</p>
				<h2 class="o-titulo o-titulo--g" id="jeito-titulo">{{ p.jeito.titulo }}</h2>
			</div>
		</div>
		<ul class="o-jeito">
		{%- for item in p.jeito.itens %}
			<li class="o-jeito__item o-janela">
				<div class="o-janela__barra" aria-hidden="true"><span class="o-janela__titulo">ok_0{{ loop.index }}.olo</span><span class="o-janela__ctrl"></span></div>
				<div class="o-janela__corpo o-jeito__corpo">
					<span class="o-jeito__icone" aria-hidden="true"><span class="o-icone o-icone--pixel"></span></span>
					<h3 class="o-jeito__titulo">{{ item.titulo }}</h3>
					<p class="o-jeito__texto">{{ item.texto }}</p>
				</div>
			</li>
		{%- endfor %}
		</ul>
	</div>
</section>

<section class="o-sec o-ctx-preto o-quem-remoto" data-secao="remoto" aria-labelledby="remoto-titulo">
	<div class="o-fundo o-fundo--linhas" aria-hidden="true"></div>
	<div class="o-wrap o-duas-colunas">
		<div>
			<p class="o-etiqueta">{{ p.remoto.etiqueta }}</p>
			<h2 class="o-titulo o-titulo--g" id="remoto-titulo">{{ p.remoto.titulo }}</h2>
		</div>
		<div>
			<ul class="o-lista-pixel">{% for i in p.remoto.itens %}<li>{{ i }}</li>{% endfor %}</ul>
			<p class="o-quem-remoto__contato"><span>{{ p.contato.titulo }}</span> <a class="o-btn o-btn--verde" href="{{ waLink('sobre', { tipo: 'equipe' }) }}" target="_blank" rel="noopener"><span class="o-icone o-icone--whatsapp" aria-hidden="true"></span>{{ p.contato.botao }}</a></p>
		</div>
	</div>
</section>

{%- set origemWaForm = "sobre-form" -%}
{%- set origemWaFinal = "sobre-final" -%}
{% include "secoes/orcamento.njk" %}
