---
layout: layouts/campanha.njk
slug: promo
og_imagem: /assets/img/og/promo.jpg
eleventyComputed:
  titulo: "{{ conteudo.paginas.promo.seo.titulo }}"
  descricao: "{{ conteudo.paginas.promo.seo.descricao }}"
---
{#- /promo/ — landing geral de campanha. ?s=<slug> troca título e subtítulo pelo serviço do anúncio. -#}
{%- from "components/formulario.njk" import formulario with context -%}
{%- set pc = conteudo.paginas.promo -%}
{%- set diag = site.config.OFERTA_DIAGNOSTICO -%}
<section class="o-promo-topo o-ctx-preto" data-secao="promo-hero">
	<div class="o-wrap o-promo-topo__grade">
		<div class="o-promo-topo__texto">
			<p class="o-etiqueta" data-o-promo-etiqueta>{{ pc.etiqueta if diag else "Orçamento" }}</p>
			<h1 class="o-pagina-topo__titulo" data-o-promo-titulo>{{ pc.titulo if diag else pc.titulo_sem_diagnostico }}</h1>
			<p class="o-pagina-topo__sub" data-o-promo-sub>{{ pc.sub if diag else pc.sub_sem_diagnostico }}</p>
			<ul class="o-promo-topo__itens">{% for item in pc.itens %}<li><span class="o-icone o-icone--o" aria-hidden="true"></span>{{ item }}</li>{% endfor %}</ul>
		</div>
		{{ formulario({ id: "formulario", posicao: "promo", modo: "promo", origemWa: "promo-form" }) }}
	</div>
	{#- Coerência anúncio × página: ?s=<slug> troca só título e subtítulo (lista fechada de slugs). Roda antes da primeira pintura. -#}
	<script>
		(function () {
			var v = {
			{%- for s in conteudo.servicos %}"{{ s.slug }}": { t: {{ s.campanha.titulo | dump | safe }}, s: {{ s.campanha.subtitulo | dump | safe }} }{% if not loop.last %}, {% endif %}{% endfor -%}
			};
			var m = /[?&]s=([a-z-]+)/.exec(location.search), d = m && v[m[1]];
			if (!d) { return; }
			document.querySelector("[data-o-promo-titulo]").textContent = d.t;
			document.querySelector("[data-o-promo-sub]").textContent = d.s;
			var ch = document.querySelector('#formulario input[data-servico="' + m[1] + '"]');
			if (ch) { ch.checked = true; }
			var sp = document.querySelector('#formulario input[name="servico_pagina"]');
			if (sp) { sp.value = m[1]; }
		})();
	</script>
</section>
{%- set servicoCampanha = "" -%}
{% include "partials/campanha-blocos.njk" %}
