---
layout: layouts/campanha.njk
pagination:
  data: conteudo.servicos
  size: 1
  alias: servico
permalink: "/promo/{{ servico.slug }}/"
eleventyComputed:
  titulo: "{{ servico.seo.title }}"
  descricao: "{{ servico.seo.description }}"
  slug: "promo-{{ servico.slug }}"
  canonical: "/servicos/{{ servico.slug }}/"
  og_imagem: "/assets/img/og/servico-{{ servico.slug }}.jpg"
---
{#- /promo/<slug>/ — serviço em modo campanha (mesma fonte da página do serviço; canonical para ela). -#}
{%- from "components/formulario.njk" import formulario with context -%}
{%- set s = servico -%}
<section class="o-promo-topo o-ctx-preto" data-secao="promo-hero">
	<div class="o-wrap o-promo-topo__grade">
		<div class="o-promo-topo__texto">
			<p class="o-etiqueta">{{ s.hero.eyebrow }}</p>
			<h1 class="o-pagina-topo__titulo">{{ s.campanha.titulo }}</h1>
			<p class="o-pagina-topo__sub">{{ s.campanha.subtitulo }}</p>
			<p class="o-resposta__texto o-resposta__texto--promo">{{ s.resposta_curta | emLinha | safe }}</p>
		</div>
		{{ formulario({ id: "formulario", posicao: "promo", modo: "promo", servico: s.slug, nomeServico: s.nome, origemWa: "promo-" + s.slug + "-form" }) }}
	</div>
</section>
{%- set faqCampanha = [] -%}
{%- for id in s.campanha.faq %}{% set item = s.faq | encontrar("id", id) %}{% if item %}{% set faqCampanha = (faqCampanha.concat([item])) %}{% endif %}{% endfor -%}
{%- set precoCampanha = s.preco -%}
{%- set servicoCampanha = s.slug -%}
{% include "partials/campanha-blocos.njk" %}
